import torch

# --- Paramètres ---
dim = 512
seq_len = 128
batch_size = 8
depth = 2 # 2 couches suffisent pour la vérification

# --- 1. Création des modèles ---
model_eager = DeepTransformerEager(dim, depth).cuda()

# On clone EXACTEMENT les mêmes poids pour le modèle Checkpoint
model_ckpt = DeepTransformerCkpt(dim, depth).cuda()
model_ckpt.load_state_dict(model_eager.state_dict())

# --- 2. Même entrée ---
x = torch.randn(batch_size, seq_len, dim, device="cuda")

# --- 3. Forward + Backward ---
# Eager
out_eager = model_eager(x)
loss_eager = out_eager.sum()
loss_eager.backward()

# Checkpoint
out_ckpt = model_ckpt(x)
loss_ckpt = out_ckpt.sum()
loss_ckpt.backward()

# --- 4. Vérification Forward ---
print("🔍 Vérification Forward (Sorties)...")
try:
    torch.testing.assert_close(out_eager, out_ckpt, atol=1e-6, rtol=1e-5)
    print("✅ Forward OK : Les sorties sont numériquement identiques !")
except AssertionError as e:
    print("❌ Forward ÉCHOUÉ :")
    print(e)

# --- 5. Vérification Backward (Gradients) ---
print("\n🔍 Vérification Backward (Gradients de tous les paramètres)...")
grad_ok = True
for i, (p_eager, p_ckpt) in enumerate(zip(model_eager.parameters(), model_ckpt.parameters())):
    if p_eager.grad is not None and p_ckpt.grad is not None:
        try:
            torch.testing.assert_close(p_eager.grad, p_ckpt.grad, atol=1e-5, rtol=1e-4)
        except AssertionError:
            grad_ok = False
            print(f"❌ Différence de gradient détectée sur le paramètre {i}")

if grad_ok:
    print("✅ Backward OK : Tous les gradients sont numériquement identiques !")


