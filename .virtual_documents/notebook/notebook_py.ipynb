import torch

# 1. On crée des tenseurs avec des valeurs précises (pas d'aléatoire)
# Entrée : Batch de 2, Dimension 3
x = torch.tensor([[1.0, 0.5, -1.0], 
                  [2.0, -0.5, 0.0]])

# Poids W1 : 2 neurones cachés, 3 entrées
W1 = torch.tensor([[ 1.0, -1.0,  0.5], 
                   [-0.5,  2.0, -1.0]], requires_grad=True)
b1 = torch.tensor([0.1, -0.2], requires_grad=True)

# Poids W2 : 1 sortie, 2 entrées
W2 = torch.tensor([[1.5, -0.5]], requires_grad=True)
b2 = torch.tensor([0.0], requires_grad=True)

# 2. Forward pass (Linear -> ReLU -> Linear)
h = x @ W1.T + b1
a = torch.relu(h)
y = a @ W2.T + b2  # <-- CORRIGÉ ICI : on utilise bien 'a' et pas 'x'

# 3. Loss (Somme simple pour que le gradient soit facile à calculer)
loss = y.sum()

# 4. Backward pass
loss.backward()

# 5. Affichage des gradients de référence
print("=== RÉFÉRENCE PYTORCH ===")
print(f"Loss = {loss.item():.6f}")
print(f"\nW1.grad =\n{W1.grad}")
print(f"\nb1.grad =\n{b1.grad}")
print(f"\nW2.grad =\n{W2.grad}")
print(f"\nb2.grad =\n{b2.grad}")


import gc
import torch
import torch.nn as nn
import pandas as pd

# On recrée exactement la même architecture que NeuroDSL
class DeepMLP(nn.Module):
    def __init__(self, dim, depth):
        super().__init__()
        layers = []
        for _ in range(depth):
            layers.append(nn.Linear(dim, dim, bias=False)) # W1
            layers.append(nn.ReLU())
            layers.append(nn.Linear(dim, dim, bias=False)) # W2
        self.net = nn.Sequential(*layers)
        
    def forward(self, x):
        return self.net(x)

# Paramètres identiques à NeuroDSL
dim = 512
seq_len = 128
batch_size = 8
depths = [1, 2, 4, 8]

results_pytorch_mlp = []

for depth in depths:
    print(f"\n=== Profondeur MLP = {depth} ===")
    
    model = DeepMLP(dim, depth).cuda()
    # Même taille d'entrée aplatie : (Batch*Seq, Dim)
    x = torch.randn(batch_size * seq_len, dim, device="cuda")
    optim = torch.optim.SGD(model.parameters(), lr=0.01)
    
    def step():
        optim.zero_grad(set_to_none=True)
        loss = model(x).sum()
        loss.backward()
        optim.step()
        
    t = benchmark(step, runs=20, warmup=5)
    m = peak_memory(step)
    
    results_pytorch_mlp.append({
        "Depth": depth, "Framework": "PyTorch Eager", 
        "Time (ms)": round(t.mean(), 2), "Memory (MiB)": round(m, 2)
    })
    
    # Clean
    del model, x, optim
    gc.collect()
    torch.cuda.empty_cache()

df_pytorch_mlp = pd.DataFrame(results_pytorch_mlp)
print("\n📈 RÉSULTATS PYTORCH MLP (Apples to Apples) :")
display(df_pytorch_mlp)






