import gc
import torch
import torch.nn as nn
import torch.utils.checkpoint as cp

# --- Définition d'un vrai bloc Transformer ---
class TransformerBlock(nn.Module):
    def __init__(self, dim=512, num_heads=8):
        super().__init__()
        self.dim = dim
        self.norm1 = nn.LayerNorm(dim)
        self.attn = nn.MultiheadAttention(dim, num_heads, batch_first=True)
        self.norm2 = nn.LayerNorm(dim)
        self.mlp = nn.Sequential(
            nn.Linear(dim, dim * 4),
            nn.GELU(),
            nn.Linear(dim * 4, dim)
        )

    def forward(self, x):
        # Self-Attention
        res = x
        x = self.norm1(x)
        attn_out, _ = self.attn(x, x, x)
        x = res + attn_out
        # MLP
        res = x
        x = self.norm2(x)
        x = res + self.mlp(x)
        return x

# --- Version avec Gradient Checkpointing ---
class TransformerBlockCkpt(nn.Module):
    def __init__(self, dim=512, num_heads=8):
        super().__init__()
        self.dim = dim
        self.norm1 = nn.LayerNorm(dim)
        self.attn = nn.MultiheadAttention(dim, num_heads, batch_first=True)
        self.norm2 = nn.LayerNorm(dim)
        self.mlp = nn.Sequential(
            nn.Linear(dim, dim * 4),
            nn.GELU(),
            nn.Linear(dim * 4, dim)
        )

    def _forward(self, x):
        # Même logique, mais dans une fonction séparée pour le checkpoint
        res = x
        x = self.norm1(x)
        attn_out, _ = self.attn(x, x, x)
        x = res + attn_out
        res = x
        x = self.norm2(x)
        x = res + self.mlp(x)
        return x

    def forward(self, x):
        # On wrappe l'exécution avec checkpoint
        return cp.checkpoint(self._forward, x, use_reentrant=False)

# --- Paramètres de test (Dimension 512, Seq 128, Batch 8) ---
dim = 512
seq_len = 128
batch_size = 8

# --- 1. PyTorch Eager ---
print("🔧 Initialisation Transformer Eager...")
model_eager = TransformerBlock(dim).cuda()
x_eager = torch.randn(batch_size, seq_len, dim, device="cuda")
optim_eager = torch.optim.SGD(model_eager.parameters(), lr=0.01)

def step_eager():
    optim_eager.zero_grad(set_to_none=True)
    out = model_eager(x_eager)
    loss = out.sum()
    loss.backward()
    optim_eager.step()

print("🔥 Benchmark Transformer Eager...")
t_eager = benchmark(step_eager, runs=50)
m_eager = peak_memory(step_eager)

# Clean memory before next test
del model_eager, x_eager, optim_eager
gc.collect()
torch.cuda.empty_cache()

# --- 2. PyTorch + Gradient Checkpointing ---
print("\n🔧 Initialisation Transformer + Checkpoint...")
model_ckpt = TransformerBlockCkpt(dim).cuda()
x_ckpt = torch.randn(batch_size, seq_len, dim, device="cuda")
optim_ckpt = torch.optim.SGD(model_ckpt.parameters(), lr=0.01)

def step_ckpt():
    optim_ckpt.zero_grad(set_to_none=True)
    out = model_ckpt(x_ckpt)
    loss = out.sum()
    loss.backward()
    optim_ckpt.step()

print("🔥 Benchmark Transformer + Checkpoint...")
t_ckpt = benchmark(step_ckpt, runs=50)
m_ckpt = peak_memory(step_ckpt)


