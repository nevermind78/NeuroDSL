# On réutilise les classes du bloc précédent
# (Assure-toi d'avoir exécuté la cellule avec TransformerBlock et TransformerBlockCkpt)

class DeepTransformerEager(nn.Module):
    def __init__(self, dim=512, depth=4):
        super().__init__()
        self.layers = nn.Sequential(*[TransformerBlock(dim) for _ in range(depth)])
        
    def forward(self, x):
        return self.layers(x)

class DeepTransformerCkpt(nn.Module):
    def __init__(self, dim=512, depth=4):
        super().__init__()
        self.layers = nn.Sequential(*[TransformerBlockCkpt(dim) for _ in range(depth)])
        
    def forward(self, x):
        return self.layers(x)

