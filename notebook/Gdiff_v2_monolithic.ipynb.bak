    "# =======================================================================\n",
    "# CELLULE 11 : Création de l'Opérateur \"Physique\" dans NeuroDSL\n",
    "# =======================================================================\n",
    "using LinearAlgebra\n",
    "using NeuroDSL\n",
    "\n",
    "println(\"=== COMPILATION DU MOTEUR PHYSIQUE DIFFÉRENTIABLE ===\")\n",
    "\n",
    "# On enregistre une fonction de perte (Loss) qui simule un élastique autour d'aimants\n",
    "register_op!(:traj_optimizer, (dev, out, inputs, attrs, out_sym, out_node, ctx) -> begin\n",
    "    W = inputs[1] # W = Waypoints (Les points de passage du drone)\n",
    "    N = size(W, 1)\n",
    "    \n",
    "    S = Float32[7.0, 0.0]   # Départ (Start)\n",
    "    E = Float32[10.0, 10.0] # Arrivée (End)\n",
    "    \n",
    "    # Bâtiment 1 (Gros obstacle au milieu)\n",
    "    O1 = Float32[4.5, 5.5]; R1_sq = 3.0f0^2 \n",
    "    # Bâtiment 2 (Petit obstacle sur le côté)\n",
    "    O2 = Float32[8.0, 2.5]; R2_sq = 1.8f0^2 \n",
    "    \n",
    "    loss = 0.0f0\n",
    "    \n",
    "    # FORCE 1 : TENSION (Raccourcir l'élastique)\n",
    "    loss += sum((W[1, :] .- S).^2)\n",
    "    for i in 1:N-1\n",
    "        loss += sum((W[i+1, :] .- W[i, :]).^2)\n",
    "    end\n",
    "    loss += sum((E .- W[N, :]).^2)\n",
    "    \n",
    "    # FORCE 2 : RÉPULSION (Fuire les bâtiments)\n",
    "    for i in 1:N\n",
    "        d1 = sum((W[i, :] .- O1).^2)\n",
    "        if d1 < R1_sq\n",
    "            loss += 15.0f0 * (R1_sq - d1)^2 # Pénalité douce mais puissante\n",
    "        end\n",
    "        d2 = sum((W[i, :] .- O2).^2)\n",
    "        if d2 < R2_sq\n",
    "            loss += 15.0f0 * (R2_sq - d2)^2\n",
    "        end\n",
    "    end\n",
    "    \n",
    "    out .= loss\n",
    "    if ctx !== nothing\n",
    "        ctx[out_sym] = Dict(:W => W, :S => S, :E => E, :O1 => O1, :R1_sq => R1_sq, :O2 => O2, :R2_sq => R2_sq, :N => N)\n",
    "    end\n",
    "end)\n",
    "\n",
    "CUSTOM_SHAPE_RULES[:traj_optimizer] = (inputs, attrs) -> (1, 1)\n",
    "\n",
    "# Le calcul exact de la dérivée (Le Gradient = La force physique qui pousse chaque point)\n",
    "GRAD_RULES[:traj_optimizer] = (dev, dy, ctx, inputs) -> begin\n",
    "    W = ctx[:W]; S = ctx[:S]; E = ctx[:E]; N = ctx[:N]\n",
    "    O1 = ctx[:O1]; R1_sq = ctx[:R1_sq]; O2 = ctx[:O2]; R2_sq = ctx[:R2_sq]\n",
    "    \n",
    "    grad_W = zeros(Float32, N, 2)\n",
    "    \n",
    "    # Dérivée de l'élastique (Tire vers les voisins)\n",
    "    grad_W[1, :] .+= 2.0f0 .* (W[1, :] .- S) .- 2.0f0 .* (W[2, :] .- W[1, :])\n",
    "    for i in 2:N-1\n",
    "        grad_W[i, :] .+= 2.0f0 .* (W[i, :] .- W[i-1, :]) .- 2.0f0 .* (W[i+1, :] .- W[i, :])\n",
    "    end\n",
    "    grad_W[N, :] .+= 2.0f0 .* (W[N, :] .- W[N-1, :]) .- 2.0f0 .* (E .- W[N, :])\n",
    "    \n",
    "    # Dérivée des bâtiments (Pousse vers l'extérieur si on est trop près)\n",
    "    for i in 1:N\n",
    "        d1 = sum((W[i, :] .- O1).^2)\n",
    "        if d1 < R1_sq\n",
    "            grad_W[i, :] .+= 15.0f0 .* 2.0f0 .* (R1_sq - d1) .* (-2.0f0 .* (W[i, :] .- O1))\n",
    "        end\n",
    "        d2 = sum((W[i, :] .- O2).^2)\n",
    "        if d2 < R2_sq\n",
    "            grad_W[i, :] .+= 15.0f0 .* 2.0f0 .* (R2_sq - d2) .* (-2.0f0 .* (W[i, :] .- O2))\n",
    "        end\n",
    "    end\n",
    "    \n",
    "    return (grad_W .* dy[1], )\n",
    "end\n",
    "\n",
    "println(\"✅ Moteur physique intégré. Prêt pour l'animation.\")"
   ]
  },
