   "source": [
    "# =======================================================================\n",
    "# CELLULE UNIFIÉE : Moteur Physique avec Point de Départ Dynamique\n",
    "# =======================================================================\n",
    "using LinearAlgebra, Plots, IJulia\n",
    "using NeuroDSL\n",
    "\n",
    "println(\"=== COMPILATION DU MOTEUR V4 (DYNAMIC START) ===\")\n",
    "\n",
    "# 🛠️ PANNEAU DE CONFIGURATION DE LA MISSION 🛠️\n",
    "# Changez ces valeurs, tout le reste s'adaptera automatiquement !\n",
    "START_X = 0.0f0\n",
    "START_Y = 5.0f0\n",
    "\n",
    "END_X = 10.0f0\n",
    "END_Y = 10.0f0\n",
    "\n",
    "# 1. DÉFINITION DE L'OPÉRATEUR PHYSIQUE\n",
    "register_op!(:traj_optimizer_v4, (dev, out, inputs, attrs, out_sym, out_node, ctx) -> begin\n",
    "    W = inputs[1]\n",
    "    N = size(W, 1)\n",
    "    \n",
    "    # La physique lit directement le panneau de configuration\n",
    "    S = Float32[START_X, START_Y] \n",
    "    E = Float32[END_X, END_Y]\n",
    "    \n",
    "    marge = 0.5f0 \n",
    "    O1 = Float32[4.0, 6.0]; R1_sq = (2.5f0 + marge)^2 \n",
    "    O2 = Float32[7.0, 2.5]; R2_sq = (2.0f0 + marge)^2 \n",
    "    O3 = Float32[7.5, 8.5]; R3_sq = (2.0f0 + marge)^2 \n",
    "    \n",
    "    loss = 0.0f0\n",
    "    \n",
    "    loss += sum((W[1, :] .- S).^2)\n",
    "    for i in 1:N-1; loss += sum((W[i+1, :] .- W[i, :]).^2); end\n",
    "    loss += sum((E .- W[N, :]).^2)\n",
    "    \n",
    "    force_mur = 500.0f0\n",
    "    for i in 1:N\n",
    "        d1 = sum((W[i, :] .- O1).^2); if d1 < R1_sq; loss += force_mur * (R1_sq - d1)^2; end\n",
    "        d2 = sum((W[i, :] .- O2).^2); if d2 < R2_sq; loss += force_mur * (R2_sq - d2)^2; end\n",
    "        d3 = sum((W[i, :] .- O3).^2); if d3 < R3_sq; loss += force_mur * (R3_sq - d3)^2; end\n",
    "    end\n",
    "    \n",
    "    out .= loss\n",
    "    if ctx !== nothing\n",
    "        ctx[out_sym] = Dict(:W=>W, :S=>S, :E=>E, :N=>N, :O1=>O1, :R1_sq=>R1_sq, :O2=>O2, :R2_sq=>R2_sq, :O3=>O3, :R3_sq=>R3_sq, :force=>force_mur)\n",
    "    end\n",
    "end)\n",
    "\n",
    "CUSTOM_SHAPE_RULES[:traj_optimizer_v4] = (inputs, attrs) -> (1, 1)\n",
    "\n",
    "GRAD_RULES[:traj_optimizer_v4] = (dev, dy, ctx, inputs) -> begin\n",
    "    W = ctx[:W]; S = ctx[:S]; E = ctx[:E]; N = ctx[:N]\n",
    "    O1 = ctx[:O1]; R1_sq = ctx[:R1_sq]; O2 = ctx[:O2]; R2_sq = ctx[:R2_sq]; O3 = ctx[:O3]; R3_sq = ctx[:R3_sq]\n",
    "    force_mur = ctx[:force]\n",
    "    \n",
    "    grad_W = zeros(Float32, N, 2)\n",
    "    \n",
    "    grad_W[1, :] .+= 2.0f0 .* (W[1, :] .- S) .- 2.0f0 .* (W[2, :] .- W[1, :])\n",
    "    for i in 2:N-1\n",
    "        grad_W[i, :] .+= 2.0f0 .* (W[i, :] .- W[i-1, :]) .- 2.0f0 .* (W[i+1, :] .- W[i, :])\n",
    "    end\n",
    "    grad_W[N, :] .+= 2.0f0 .* (W[N, :] .- W[N-1, :]) .- 2.0f0 .* (E .- W[N, :])\n",
    "    \n",
    "    for i in 1:N\n",
    "        d1 = sum((W[i, :] .- O1).^2); if d1 < R1_sq; grad_W[i, :] .+= force_mur .* 2.0f0 .* (R1_sq - d1) .* (-2.0f0 .* (W[i, :] .- O1)); end\n",
    "        d2 = sum((W[i, :] .- O2).^2); if d2 < R2_sq; grad_W[i, :] .+= force_mur .* 2.0f0 .* (R2_sq - d2) .* (-2.0f0 .* (W[i, :] .- O2)); end\n",
    "        d3 = sum((W[i, :] .- O3).^2); if d3 < R3_sq; grad_W[i, :] .+= force_mur .* 2.0f0 .* (R3_sq - d3) .* (-2.0f0 .* (W[i, :] .- O3)); end\n",
    "    end\n",
    "    return (grad_W .* dy[1], )\n",
    "end\n",
    "\n",
    "# 2. ANIMATION ET OPTIMISATION\n",
    "g_drone_dyn = NeuroGraph(device=Backend.CPUDevice())\n",
    "N_waypoints = 25 \n",
    "\n",
    "W_init = zeros(Float32, N_waypoints, 2)\n",
    "for i in 1:N_waypoints\n",
    "    # Interpolation mathématique automatique basée sur START et END\n",
    "    fraction = Float32(i) / Float32(N_waypoints + 1)\n",
    "    W_init[i, 1] = START_X + (END_X - START_X) * fraction\n",
    "    W_init[i, 2] = START_Y + (END_Y - START_Y) * fraction\n",
    "end\n",
    "\n",
    "set!(g_drone_dyn, :waypoints, W_init; is_param=true)\n",
    "addrule!(g_drone_dyn, GraphRule(:loss, [:waypoints], :traj_optimizer_v4))\n",
    "\n",
    "epochs = 1000\n",
    "lr_path = 2f-3\n",
    "cercle(x, y, r) = (x .+ r.*cos.(LinRange(0, 2π, 50)), y .+ r.*sin.(LinRange(0, 2π, 50)))\n",
    "\n",
    "for epoch in 1:epochs\n",
    "    p_node = node(g_drone_dyn, :waypoints)\n",
    "    p_node.gradient = nothing \n",
    "    \n",
    "    zero_grads!(g_drone_dyn)\n",
    "    demand!(g_drone_dyn, :loss)\n",
    "    backward_graph!(g_drone_dyn, :loss)\n",
    "    \n",
    "    if p_node.gradient !== nothing\n",
    "        grad_clipped = clamp.(p_node.gradient, -15.0f0, 15.0f0)\n",
    "        \n",
    "        current_lr = lr_path * (1.0f0 - (Float32(epoch)/Float32(epochs))^2)\n",
    "        current_lr = max(current_lr, 1f-4)\n",
    "        \n",
    "        new_W = p_node.value .- current_lr .* grad_clipped\n",
    "        set!(g_drone_dyn, :waypoints, new_W; is_param=true)\n",
    "    end\n",
    "    \n",
    "    if epoch % 20 == 0 || epoch == epochs\n",
    "        IJulia.clear_output(true)\n",
    "        current_W = node(g_drone_dyn, :waypoints).value\n",
    "        \n",
    "        p = plot(title=\"Navigation Différentielle Dynamique ($epoch/1000)\", \n",
    "                 aspect_ratio=:equal, xlims=(-1, 11), ylims=(-1, 11), \n",
    "                 legend=:outertopright, grid=true, size=(850, 650))\n",
    "        \n",
    "        plot!(p, cercle(4.0, 6.0, 2.5), fill=true, color=:red, alpha=0.3, label=\"Tour Centrale\")\n",
    "        plot!(p, cercle(7.0, 2.5, 2.0), fill=true, color=:orange, alpha=0.3, label=\"Immeuble Sud\")\n",
    "        plot!(p, cercle(7.5, 8.5, 2.0), fill=true, color=:purple, alpha=0.3, label=\"Immeuble Nord\")\n",
    "        \n",
    "        plot!(p, cercle(4.0, 6.0, 3.0), color=:red, style=:dash, lw=1.5, label=\"Marge IA (0.5m)\")\n",
    "        plot!(p, cercle(7.0, 2.5, 2.5), color=:orange, style=:dash, lw=1.5, label=\"\")\n",
    "        plot!(p, cercle(7.5, 8.5, 2.5), color=:purple, style=:dash, lw=1.5, label=\"\")\n",
    "        \n",
    "        # Le dessin du départ et de l'arrivée lit le panneau de configuration !\n",
    "        scatter!(p, [START_X], [START_Y], color=:blue, markersize=8, label=\"Départ ($START_X, $START_Y)\")\n",
    "        scatter!(p, [END_X], [END_Y], color=:green, markersize=8, label=\"Arrivée ($END_X, $END_Y)\")\n",
    "        \n",
    "        # Le dessin du chemin lit le panneau de configuration !\n",
    "        X_path = vcat(START_X, current_W[:, 1], END_X)\n",
    "        Y_path = vcat(START_Y, current_W[:, 2], END_Y)\n",
    "        plot!(p, X_path, Y_path, color=:black, lw=3, label=\"Chemin du Drone\", marker=:circle, markersize=4, markercolor=:white)\n",
    "        \n",
    "        display(p)\n",
    "        sleep(0.01)\n",
    "    end\n",
    "end\n",
    "println(\"✅ Parcours sécurisé terminé depuis les nouvelles coordonnées !\")"
   ]
  },
