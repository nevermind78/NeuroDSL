   "source": [
    "# =======================================================================\n",
    "# CELLULE 10 : SIMULATION INDUSTRIELLE RÉELLE (Centrale Électrique UCI)\n",
    "# =======================================================================\n",
    "using LinearAlgebra\n",
    "using Plots\n",
    "using IJulia\n",
    "using Statistics\n",
    "using NeuroDSL\n",
    "\n",
    "println(\"=== DÉMARRAGE DE LA SIMULATION INDUSTRIELLE RÉELLE ===\")\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# 1. LES VRAIES DONNÉES (Extrait de l'UCI Machine Learning Repository - CCPP)\n",
    "# ---------------------------------------------------------\n",
    "# Nous prenons 30 relevés réels consécutifs de la centrale\n",
    "T_real = Float32[14.96, 25.18, 5.11, 20.86, 10.82, 26.27, 15.89, 9.48, 14.65, 11.74, 18.25, 17.69, 6.85, 14.39, 23.89, 21.03, 14.50, 12.39, 12.05, 20.02, 13.91, 14.34, 11.22, 17.15, 10.37, 21.14, 25.86, 13.01, 18.26, 12.82]\n",
    "V_real = Float32[41.76, 62.96, 39.40, 57.32, 37.50, 59.44, 43.96, 44.71, 39.00, 43.38, 62.00, 41.51, 39.32, 45.47, 57.38, 55.46, 38.08, 41.48, 38.25, 45.46, 39.40, 58.00, 43.83, 40.71, 38.64, 53.64, 73.66, 39.02, 63.85, 45.31]\n",
    "AP_real = Float32[1024.07, 1020.04, 1012.16, 1010.24, 1009.23, 1012.23, 1014.02, 1019.12, 1016.42, 1010.51, 1013.90, 1021.06, 1016.96, 1016.89, 1012.44, 1013.09, 1018.66, 1020.17, 1016.48, 1011.02, 1014.28, 1014.71, 1020.25, 1022.05, 1018.28, 1012.30, 1011.23, 1014.64, 1009.21, 1013.56]\n",
    "RH_real = Float32[73.17, 59.08, 92.14, 76.64, 96.62, 58.77, 75.24, 66.43, 39.05, 83.22, 70.08, 68.61, 83.47, 85.53, 76.23, 73.14, 59.39, 87.16, 81.33, 78.43, 79.52, 69.34, 72.82, 71.94, 82.35, 78.89, 57.51, 62.30, 77.01, 80.32]\n",
    "\n",
    "# Cible réelle : L'énergie produite en Mégawatts (EP)\n",
    "EP_real = Float32[463.26, 444.37, 488.56, 446.48, 473.90, 443.67, 467.35, 478.42, 471.94, 469.75, 449.64, 460.67, 483.92, 463.98, 445.69, 448.24, 466.82, 469.01, 473.19, 447.85, 470.92, 464.39, 473.23, 458.12, 475.24, 447.50, 440.09, 468.61, 447.38, 465.71]\n",
    "\n",
    "# Normalisation des données pour la stabilité mathématique (Z-score)\n",
    "X_brut = vcat(T_real', V_real', AP_real', RH_real') # Matrice 4 x 30\n",
    "Y_brut = reshape(EP_real, 1, 30)\n",
    "\n",
    "X_mean, X_std = mean(X_brut, dims=2), std(X_brut, dims=2)\n",
    "Y_mean, Y_std = mean(Y_brut), std(Y_brut)\n",
    "\n",
    "X_norm = (X_brut .- X_mean) ./ X_std\n",
    "Y_norm = (Y_brut .- Y_mean) ./ Y_std\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# 2. CONSTRUCTION DU GRAPHE DYNAMIQUE\n",
    "# ---------------------------------------------------------\n",
    "g_plant = NeuroGraph(device=Backend.CPUDevice())\n",
    "\n",
    "set!(g_plant, :X_in, X_norm; is_param=false)\n",
    "set!(g_plant, :Y_target, Y_norm; is_param=false)\n",
    "\n",
    "# La matrice de réparation (Transparente au début)\n",
    "set!(g_plant, :W_plasticity, Matrix{Float32}(I, 4, 4); is_param=false)\n",
    "\n",
    "# Le décodeur de la centrale (Apprend au début)\n",
    "set!(g_plant, :W_decode, randn(Float32, 1, 4) .* 0.1f0; is_param=true)\n",
    "\n",
    "# Architecture : Capteurs -> Matrice Réparation -> Décodeur -> Puissance\n",
    "addrule!(g_plant, GraphRule(:X_repare, [:W_plasticity, :X_in], :matmul))\n",
    "addrule!(g_plant, GraphRule(:Prediction, [:W_decode, :X_repare], :matmul))\n",
    "addrule!(g_plant, GraphRule(:loss, [:Prediction, :Y_target], :mse_loss))\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# 3. MOTEUR D'ANIMATION ET D'ENTRAÎNEMENT\n",
    "# ---------------------------------------------------------\n",
    "epochs = 800\n",
    "lr_decode = 1f-2\n",
    "lr_plasticity = 5f-3\n",
    "\n",
    "history_loss = Float32[]\n",
    "\n",
    "for epoch in 1:epochs\n",
    "    \n",
    "    # GESTION DES ÉVÉNEMENTS DANS LE TEMPS\n",
    "    etat_systeme = \"\"\n",
    "    couleur_courbe = :blue\n",
    "    \n",
    "    if epoch < 250\n",
    "        # PHASE 1 : Fonctionnement normal, le décodeur se calibre.\n",
    "        etat_systeme = \"PHASE 1 : Calibrage Normal (Capteurs 100% Opérationnels)\"\n",
    "        couleur_courbe = :blue\n",
    "        \n",
    "    elseif epoch == 250\n",
    "        # LE CRASH MATÉRIEL : Température et Vide tombent à 0\n",
    "        X_crash = copy(X_norm)\n",
    "        X_crash[1, :] .= 0.0f0 # Capteur T détruit\n",
    "        X_crash[2, :] .= 0.0f0 # Capteur V détruit\n",
    "        set!(g_plant, :X_in, X_crash; is_param=false)\n",
    "        \n",
    "    elseif epoch >= 250 && epoch < 350\n",
    "        # PHASE 2 : La centrale encaisse le choc, prédictions fausses\n",
    "        etat_systeme = \"PHASE 2 : CRASH CAPTEURS (T et V détruits !)\"\n",
    "        couleur_courbe = :red\n",
    "        \n",
    "    elseif epoch == 350\n",
    "        # ACTIVATION DU REWIRING : On fige le décodeur, on active la réparation\n",
    "        etat_systeme = \"ACTIVATION NEUROPLASTICITÉ...\"\n",
    "        set!(g_plant, :W_decode, node(g_plant, :W_decode).value; is_param=false)\n",
    "        set!(g_plant, :W_plasticity, node(g_plant, :W_plasticity).value; is_param=true)\n",
    "        node(g_plant, :W_plasticity).gradient = nothing # Purge\n",
    "        \n",
    "    else\n",
    "        # PHASE 3 : La matrice de réparation apprend à compenser avec AP et RH\n",
    "        etat_systeme = \"PHASE 3 : Réparation IA en cours (Hot-Rewiring)\"\n",
    "        couleur_courbe = :green\n",
    "        \n",
    "        # Rétropropagation exclusive sur W_plasticity\n",
    "        zero_grads!(g_plant)\n",
    "        demand!(g_plant, :loss)\n",
    "        backward_graph!(g_plant, :loss)\n",
    "        \n",
    "        p_node = node(g_plant, :W_plasticity)\n",
    "        if p_node.gradient !== nothing\n",
    "            grad_clipped = clamp.(p_node.gradient, -2.0f0, 2.0f0)\n",
    "            new_W = p_node.value .- lr_plasticity .* grad_clipped\n",
    "            set!(g_plant, :W_plasticity, new_W; is_param=true)\n",
    "        end\n",
    "    end\n",
    "    \n",
    "    # Entraînement initial du décodeur (Phase 1)\n",
    "    if epoch < 250\n",
    "        zero_grads!(g_plant)\n",
    "        demand!(g_plant, :loss)\n",
    "        backward_graph!(g_plant, :loss)\n",
    "        d_node = node(g_plant, :W_decode)\n",
    "        if d_node.gradient !== nothing\n",
    "            new_W = d_node.value .- lr_decode .* d_node.gradient\n",
    "            set!(g_plant, :W_decode, new_W; is_param=true)\n",
    "        end\n",
    "    end\n",
    "    \n",
    "    # ---------------------------------------------------------\n",
    "    # AFFICHAGE EN TEMPS RÉEL (Tous les 10 epochs pour fluidité)\n",
    "    # ---------------------------------------------------------\n",
    "    if epoch % 10 == 0 || epoch == epochs\n",
    "        loss_val = demand!(g_plant, :loss)[1]\n",
    "        pred_norm = demand!(g_plant, :Prediction)\n",
    "        \n",
    "        # Dé-normalisation pour afficher de vrais Mégawatts sur le graphique\n",
    "        pred_real = vec((pred_norm .* Y_std) .+ Y_mean)\n",
    "        push!(history_loss, loss_val)\n",
    "        \n",
    "        IJulia.clear_output(true)\n",
    "        \n",
    "        # Graphique 1 : La Courbe de Production\n",
    "        p1 = plot(1:30, EP_real, title=etat_systeme, label=\"Production Réelle (MW)\", color=:black, lw=3, ylims=(430, 495), legend=:bottomright, xlabel=\"Relevés Temporels (30 heures)\", ylabel=\"Énergie (Mégawatts)\")\n",
    "        plot!(p1, 1:30, pred_real, label=\"Prédiction de l'IA\", color=couleur_courbe, lw=2, style=:dash)\n",
    "        \n",
    "        # Graphique 2 : L'évolution de l'Erreur (MSE Normalisée)\n",
    "        p2 = plot(1:length(history_loss), history_loss, title=\"Erreur Interne du Système (MSE)\", label=\"Loss\", color=:purple, lw=2, xlabel=\"Itérations (x10)\")\n",
    "        \n",
    "        display(plot(p1, p2, layout=(2,1), size=(850, 700)))\n",
    "        sleep(0.01)\n",
    "    end\n",
    "end\n",
    "println(\"✅ Simulation industrielle terminée. Le système a survécu à la panne.\")"
   ]
  },
