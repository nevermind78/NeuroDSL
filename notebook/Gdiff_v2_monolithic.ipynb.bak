   "source": [
    "# =======================================================================\n",
    "# CELLULE 8.2 : Tempête de Bruit & Re-câblage Autonome en Direct\n",
    "# =======================================================================\n",
    "println(\"--- Lancement de la Simulation Dynamique ---\")\n",
    "\n",
    "# 1. Création d'un Graphe Vierge pour l'expérience\n",
    "g2 = NeuroGraph(device=Backend.CPUDevice())\n",
    "N = 5\n",
    "\n",
    "set!(g2, :x_in, reshape(Float32[10.0, 5.0, 8.0, 2.0, 1.0], N, 1); is_param=false)\n",
    "set!(g2, :target, reshape(Float32[20.0, 10.0, 16.0, 4.0, 2.0], N, 1); is_param=false)\n",
    "\n",
    "# Couche initiale figée\n",
    "set!(g2, :W1, Matrix{Float32}(2.0I, N, N); is_param=false) \n",
    "\n",
    "# Nœud de bruit (sera modifié à la volée)\n",
    "set!(g2, :noise_mask, ones(Float32, N, 1); is_param=false)\n",
    "\n",
    "# Matrice de récupération (Identité au départ, elle ne sait rien)\n",
    "set!(g2, :W_rec, Matrix{Float32}(I, N, N); is_param=true)\n",
    "\n",
    "addrule!(g2, GraphRule(:h1, [:W1, :x_in], :matmul))\n",
    "addrule!(g2, GraphRule(:h1_noisy, [:h1, :noise_mask], :soft_gate_layer))\n",
    "addrule!(g2, GraphRule(:h2_recovered, [:W_rec, :h1_noisy], :matmul))\n",
    "addrule!(g2, GraphRule(:loss, [:h2_recovered, :target], :mse_loss))\n",
    "\n",
    "# 2. Variables pour l'historique du graphique\n",
    "epochs = 2000\n",
    "lr_noise = 2f-4\n",
    "\n",
    "history_loss = Float32[]\n",
    "history_c2 = Float32[] # On traque le canal 2 (Cible: 10.0)\n",
    "history_c4 = Float32[] # On traque le canal 4 (Cible: 4.0)\n",
    "\n",
    "# 3. Boucle d'apprentissage avec animation en temps réel\n",
    "for epoch in 1:epochs\n",
    "    \n",
    "    # ⚡ INJECTION DE BRUIT ALÉATOIRE DYNAMIQUE ⚡\n",
    "    # Les canaux 2 et 4 subissent un bruit fort aléatoire à CHAQUE itération\n",
    "    current_mask = ones(Float32, N, 1)\n",
    "    current_mask[2, 1] = 0.1f0 + 0.8f0 * rand(Float32) # Fluctue entre 10% et 90% du signal\n",
    "    current_mask[4, 1] = 0.1f0 + 0.8f0 * rand(Float32) \n",
    "    \n",
    "    # Mise à jour à chaud du graphe (sans recompilation)\n",
    "    set!(g2, :noise_mask, current_mask; is_param=false)\n",
    "    \n",
    "    # --- RÉTROPROPAGATION ---\n",
    "    w_rec_node = node(g2, :W_rec)\n",
    "    w_rec_node.gradient = nothing # Purge absolue\n",
    "    \n",
    "    zero_grads!(g2)\n",
    "    loss_val = demand!(g2, :loss)[1]\n",
    "    out_val = demand!(g2, :h2_recovered)\n",
    "    backward_graph!(g2, :loss)\n",
    "    \n",
    "    if w_rec_node.gradient !== nothing\n",
    "        grad_clipped = clamp.(w_rec_node.gradient, -3.0f0, 3.0f0)\n",
    "        new_W = w_rec_node.value .- lr_noise .* grad_clipped\n",
    "        set!(g2, :W_rec, new_W; is_param=true)\n",
    "    end\n",
    "    \n",
    "    # --- ENREGISTREMENT DES DONNÉES ---\n",
    "    push!(history_loss, loss_val)\n",
    "    push!(history_c2, out_val[2])\n",
    "    push!(history_c4, out_val[4])\n",
    "    \n",
    "    # 🎥 MISE À JOUR DE L'AFFICHAGE (Animation) 🎥\n",
    "    # On met à jour l'écran toutes les 40 époques pour la fluidité\n",
    "    if epoch % 40 == 0 || epoch == epochs\n",
    "        IJulia.clear_output(true) # Efface l'image précédente\n",
    "        \n",
    "        # Sous-graphe 1 : L'évolution de la perte\n",
    "        p1 = plot(1:epoch, history_loss, \n",
    "                  title=\"Évolution de la Perte (MSE)\", \n",
    "                  label=\"Loss Globale\", color=:red, lw=2,\n",
    "                  xlabel=\"Époques\", ylabel=\"Erreur\")\n",
    "        \n",
    "        # Sous-graphe 2 : L'évolution de la reconstruction\n",
    "        p2 = plot(1:epoch, history_c2, \n",
    "                  title=\"Reconstruction Autonome du Signal Bruités\", \n",
    "                  label=\"Sortie Canal 2\", color=:blue, lw=1.5, alpha=0.7)\n",
    "        plot!(p2, 1:epoch, history_c4, \n",
    "                  label=\"Sortie Canal 4\", color=:green, lw=1.5, alpha=0.7)\n",
    "        \n",
    "        # Lignes cibles idéales\n",
    "        hline!(p2, [10.0], label=\"Cible C2 (10.0)\", style=:dash, color=:blue, lw=2)\n",
    "        hline!(p2, [4.0], label=\"Cible C4 (4.0)\", style=:dash, color=:green, lw=2)\n",
    "        \n",
    "        # Affichage du tableau de bord combiné\n",
    "        display(plot(p1, p2, layout=(2,1), size=(800, 600)))\n",
    "        \n",
    "        sleep(0.05) # Petite pause pour laisser le notebook respirer\n",
    "    end\n",
    "end\n",
    "\n",
    "println(\"✅ Entraînement dynamique terminé.\")"
   ]
  },
  {
