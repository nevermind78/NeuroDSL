    "# =======================================================================\n",
    "# CELLULE 12.2 : Simulation Avancée (Chicane et 1000 Époques)\n",
    "# =======================================================================\n",
    "using Plots\n",
    "using IJulia\n",
    "\n",
    "cercle(x, y, r) = (x .+ r.*cos.(LinRange(0, 2π, 50)), y .+ r.*sin.(LinRange(0, 2π, 50)))\n",
    "\n",
    "# On instancie un nouveau graphe propre\n",
    "g_drone2 = NeuroGraph(device=Backend.CPUDevice())\n",
    "\n",
    "N_waypoints = 25 # Plus de points pour des virages fluides\n",
    "epochs = 1000\n",
    "\n",
    "# Ligne droite suicidaire\n",
    "W_init = zeros(Float32, N_waypoints, 2)\n",
    "for i in 1:N_waypoints\n",
    "    W_init[i, 1] = 10.0f0 * (i / (N_waypoints + 1))\n",
    "    W_init[i, 2] = 10.0f0 * (i / (N_waypoints + 1))\n",
    "end\n",
    "\n",
    "set!(g_drone2, :waypoints, W_init; is_param=true)\n",
    "addrule!(g_drone2, GraphRule(:loss, [:waypoints], :traj_optimizer_v2))\n",
    "\n",
    "lr_path = 2f-3\n",
    "\n",
    "for epoch in 1:epochs\n",
    "    \n",
    "    p_node = node(g_drone2, :waypoints)\n",
    "    p_node.gradient = nothing \n",
    "    \n",
    "    zero_grads!(g_drone2)\n",
    "    loss_val = demand!(g_drone2, :loss)[1]\n",
    "    backward_graph!(g_drone2, :loss)\n",
    "    \n",
    "    if p_node.gradient !== nothing\n",
    "        grad_clipped = clamp.(p_node.gradient, -2.0f0, 2.0f0)\n",
    "        \n",
    "        # On ajoute un mini-refroidissement pour figer le chemin à la fin\n",
    "        current_lr = lr_path * (1.0f0 - (Float32(epoch)/Float32(epochs))^2)\n",
    "        current_lr = max(current_lr, 1f-4)\n",
    "        \n",
    "        new_W = p_node.value .- current_lr .* grad_clipped\n",
    "        set!(g_drone2, :waypoints, new_W; is_param=true)\n",
    "    end\n",
    "    \n",
    "    # 3. AFFICHAGE (Toutes les 15 époques)\n",
    "    if epoch % 15 == 0 || epoch == epochs\n",
    "        IJulia.clear_output(true)\n",
    "        current_W = node(g_drone2, :waypoints).value\n",
    "        \n",
    "        p = plot(title=\"Navigation Différentielle Haute Précision ($epoch/1000)\", \n",
    "                 aspect_ratio=:equal, xlims=(-1, 11), ylims=(-1, 11), \n",
    "                 legend=:outertopright, grid=true, size=(850, 650))\n",
    "        \n",
    "        # Les vrais bâtiments (Dangers Physiques)\n",
    "        plot!(p, cercle(4.0, 5.0, 3.0), fill=true, color=:red, alpha=0.3, label=\"Tour Centrale\")\n",
    "        plot!(p, cercle(7.5, 2.0, 2.0), fill=true, color=:orange, alpha=0.3, label=\"Immeuble Sud\")\n",
    "        plot!(p, cercle(6.5, 8.0, 2.0), fill=true, color=:purple, alpha=0.3, label=\"Immeuble Nord\")\n",
    "        \n",
    "        # Les \"Boucliers\" virtuels de l'IA (La marge de sécurité)\n",
    "        plot!(p, cercle(4.0, 5.0, 3.5), color=:red, style=:dash, lw=1.5, label=\"Marge IA (0.5m)\")\n",
    "        plot!(p, cercle(7.5, 2.0, 2.5), color=:orange, style=:dash, lw=1.5, label=\"\")\n",
    "        plot!(p, cercle(6.5, 8.0, 2.5), color=:purple, style=:dash, lw=1.5, label=\"\")\n",
    "        \n",
    "        # Départ et Arrivée\n",
    "        scatter!(p, [0.0], [0.0], color=:blue, markersize=8, label=\"Départ (0,0)\")\n",
    "        scatter!(p, [10.0], [10.0], color=:green, markersize=8, label=\"Arrivée (10,10)\")\n",
    "        \n",
    "        # Le chemin actuel\n",
    "        X_path = vcat(0.0, current_W[:, 1], 10.0)\n",
    "        Y_path = vcat(0.0, current_W[:, 2], 10.0)\n",
    "        \n",
    "        plot!(p, X_path, Y_path, color=:black, lw=3, label=\"Chemin du Drone\", marker=:circle, markersize=4, markercolor=:white)\n",
    "        \n",
    "        display(p)\n",
    "        sleep(0.01)\n",
    "    end\n",
    "end\n",
    "println(\"✅ Parcours sécurisé terminé avec succès !\")"
   ]
