   "source": [
    "# =======================================================================\n",
    "# CELLULE 12 : L'Optimisation de Trajectoire en Temps Réel\n",
    "# =======================================================================\n",
    "using Plots\n",
    "using IJulia\n",
    "\n",
    "# Fonction utilitaire pour dessiner les bâtiments (cercles)\n",
    "cercle(x, y, r) = (x .+ r.*cos.(LinRange(0, 2π, 50)), y .+ r.*sin.(LinRange(0, 2π, 50)))\n",
    "\n",
    "g_drone = NeuroGraph(device=Backend.CPUDevice())\n",
    "\n",
    "N_waypoints = 18\n",
    "\n",
    "# 1. INITIALISATION BÊTE (Une ligne droite qui rentre dans les murs)\n",
    "W_init = zeros(Float32, N_waypoints, 2)\n",
    "for i in 1:N_waypoints\n",
    "    W_init[i, 1] = 10.0f0 * (i / (N_waypoints + 1))\n",
    "    W_init[i, 2] = 10.0f0 * (i / (N_waypoints + 1))\n",
    "end\n",
    "\n",
    "set!(g_drone, :waypoints, W_init; is_param=true)\n",
    "\n",
    "# On connecte notre nouveau moteur physique au graphe\n",
    "addrule!(g_drone, GraphRule(:loss, [:waypoints], :traj_optimizer))\n",
    "\n",
    "# 2. BOUCLE D'OPTIMISATION & ANIMATION\n",
    "epochs = 350\n",
    "lr_path = 3f-3\n",
    "\n",
    "for epoch in 1:epochs\n",
    "    \n",
    "    # Rétropropagation pour trouver la direction de fuite\n",
    "    p_node = node(g_drone, :waypoints)\n",
    "    p_node.gradient = nothing \n",
    "    \n",
    "    zero_grads!(g_drone)\n",
    "    loss_val = demand!(g_drone, :loss)[1]\n",
    "    backward_graph!(g_drone, :loss)\n",
    "    \n",
    "    if p_node.gradient !== nothing\n",
    "        # On déplace les points selon la force physique calculée\n",
    "        grad_clipped = clamp.(p_node.gradient, -2.0f0, 2.0f0)\n",
    "        new_W = p_node.value .- lr_path .* grad_clipped\n",
    "        set!(g_drone, :waypoints, new_W; is_param=true)\n",
    "    end\n",
    "    \n",
    "    # 3. AFFICHAGE EN DIRECT (L'élastique qui se tord)\n",
    "    if epoch % 5 == 0 || epoch == epochs\n",
    "        IJulia.clear_output(true)\n",
    "        \n",
    "        current_W = node(g_drone, :waypoints).value\n",
    "        \n",
    "        # Le fond du radar\n",
    "        p = plot(title=\"Drone TrajOpt : Autopilotage par Gradient (Epoch $epoch)\", \n",
    "                 aspect_ratio=:equal, xlims=(-1, 11), ylims=(-1, 11), \n",
    "                 legend=:topleft, grid=true, size=(700, 600))\n",
    "        \n",
    "        # Dessin des Obstacles (Les champs de force répulsifs)\n",
    "        plot!(p, cercle(4.5, 5.5, 3.0), fill=true, color=:red, alpha=0.3, label=\"Bâtiment 1 (Danger)\")\n",
    "        plot!(p, cercle(8.0, 2.5, 1.8), fill=true, color=:orange, alpha=0.3, label=\"Bâtiment 2 (Danger)\")\n",
    "        \n",
    "        # Départ et Arrivée\n",
    "        scatter!(p, [0.0], [0.0], color=:blue, markersize=8, label=\"Départ (0,0)\")\n",
    "        scatter!(p, [10.0], [10.0], color=:green, markersize=8, label=\"Arrivée (10,10)\")\n",
    "        \n",
    "        # Le chemin actuel\n",
    "        X_path = vcat(0.0, current_W[:, 1], 10.0)\n",
    "        Y_path = vcat(0.0, current_W[:, 2], 10.0)\n",
    "        \n",
    "        plot!(p, X_path, Y_path, color=:purple, lw=3, label=\"Chemin du Drone\", marker=:circle, markersize=4)\n",
    "        \n",
    "        display(p)\n",
    "        sleep(0.02)\n",
    "    end\n",
    "end\n",
    "println(\"✅ Trajectoire optimale trouvée !\")"
   ]
  },
