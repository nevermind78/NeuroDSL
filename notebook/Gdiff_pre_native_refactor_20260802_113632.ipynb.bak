   "outputs": [],
   "source": [
    "# =======================================================================\n",
    "# CELLULE 8.3 COMPLÈTE & CORRIGÉE : Simulation avec Refroidissement\n",
    "# =======================================================================\n",
    "println(\"--- Lancement de la Simulation Dynamique avec Refroidissement ---\")\n",
    "\n",
    "# 🚨 PURGE DE LA MÉMOIRE (Évite le crash des 2040 éléments) 🚨\n",
    "history_loss = Float32[]\n",
    "history_c2 = Float32[]\n",
    "history_c4 = Float32[]\n",
    "\n",
    "# On réinitialise aussi la matrice de greffe pour qu'elle reparte de zéro\n",
    "set!(g2, :W_rec, Matrix{Float32}(I, 5, 5); is_param=true)\n",
    "\n",
    "epochs = 2000\n",
    "lr_noise = 2f-4\n",
    "\n",
    "for epoch in 1:epochs\n",
    "    \n",
    "    # ⚡ INJECTION DE BRUIT ALÉATOIRE DYNAMIQUE ⚡\n",
    "    current_mask = ones(Float32, 5, 1)\n",
    "    current_mask[2, 1] = 0.1f0 + 0.8f0 * rand(Float32) \n",
    "    current_mask[4, 1] = 0.1f0 + 0.8f0 * rand(Float32) \n",
    "    set!(g2, :noise_mask, current_mask; is_param=false)\n",
    "    \n",
    "    # 🥶 REFROIDISSEMENT DU TAUX D'APPRENTISSAGE\n",
    "    progress = Float32(epoch) / Float32(epochs)\n",
    "    current_lr = lr_noise * (1.0f0 - progress^1.5f0) \n",
    "    current_lr = max(current_lr, 1f-6) \n",
    "    \n",
    "    # --- RÉTROPROPAGATION ---\n",
    "    w_rec_node = node(g2, :W_rec)\n",
    "    w_rec_node.gradient = nothing \n",
    "    \n",
    "    zero_grads!(g2)\n",
    "    loss_val = demand!(g2, :loss)[1]\n",
    "    out_val = demand!(g2, :h2_recovered)\n",
    "    backward_graph!(g2, :loss)\n",
    "    \n",
    "    if w_rec_node.gradient !== nothing\n",
    "        grad_clipped = clamp.(w_rec_node.gradient, -3.0f0, 3.0f0)\n",
    "        \n",
    "        new_W = w_rec_node.value .- current_lr .* grad_clipped\n",
    "        new_W = new_W .- (1f-5 .* new_W) \n",
    "        \n",
    "        set!(g2, :W_rec, new_W; is_param=true)\n",
    "    end\n",
    "    \n",
    "    # --- ENREGISTREMENT ET AFFICHAGE ---\n",
    "    push!(history_loss, loss_val)\n",
    "    push!(history_c2, out_val[2])\n",
    "    push!(history_c4, out_val[4])\n",
    "    \n",
    "    if epoch % 40 == 0 || epoch == epochs\n",
    "        IJulia.clear_output(true) \n",
    "        \n",
    "        p1 = plot(1:epoch, history_loss, title=\"Évolution de la Perte (MSE)\", label=\"Loss Globale\", color=:red, lw=2)\n",
    "        \n",
    "        p2 = plot(1:epoch, history_c2, title=\"Reconstruction Autonome du Signal Bruités\", label=\"Sortie Canal 2\", color=:blue, lw=1.5, alpha=0.7)\n",
    "        plot!(p2, 1:epoch, history_c4, label=\"Sortie Canal 4\", color=:green, lw=1.5, alpha=0.7)\n",
    "        \n",
    "        hline!(p2, [10.0], label=\"Cible C2 (10.0)\", style=:dash, color=:blue, lw=2)\n",
    "        hline!(p2, [4.0], label=\"Cible C4 (4.0)\", style=:dash, color=:green, lw=2)\n",
    "        \n",
    "        display(plot(p1, p2, layout=(2,1), size=(800, 600)))\n",
    "        sleep(0.05)\n",
    "    end\n",
    "end\n",
    "println(\"✅ Entraînement dynamique avec refroidissement terminé.\")"
   ]
  },
