615.157 Q3204.84 612.472 3204.84 607.842 Q3204.84 603.236 3202.85 600.551 Q3200.86 597.842 3197.45 597.842 M3197.45 594.231 Q3203.01 594.231 3206.18 597.842 Q3209.35 601.453 3209.35 607.842 Q3209.35 614.208 3206.18 617.842 Q3203.01 621.453 3197.45 621.453 Q3191.87 621.453 3188.7 617.842 Q3185.55 614.208 3185.55 607.842 Q3185.55 601.453 3188.7 597.842 Q3191.87 594.231 3197.45 594.231 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip130)\" d=\"M3237.96 605.134 L3237.96 620.782 L3233.7 620.782 L3233.7 605.273 Q3233.7 601.592 3232.27 599.764 Q3230.83 597.935 3227.96 597.935 Q3224.51 597.935 3222.52 600.134 Q3220.53 602.333 3220.53 606.129 L3220.53 620.782 L3216.25 620.782 L3216.25 594.856 L3220.53 594.856 L3220.53 598.884 Q3222.06 596.546 3224.12 595.389 Q3226.2 594.231 3228.91 594.231 Q3233.38 594.231 3235.67 597.009 Q3237.96 599.764 3237.96 605.134 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip130)\" d=\"M3268.63 606.754 L3268.63 608.838 L3249.05 608.838 Q3249.33 613.236 3251.69 615.551 Q3254.07 617.842 3258.31 617.842 Q3260.76 617.842 3263.05 617.24 Q3265.37 616.639 3267.64 615.435 L3267.64 619.463 Q3265.35 620.435 3262.94 620.944 Q3260.53 621.453 3258.05 621.453 Q3251.85 621.453 3248.22 617.842 Q3244.61 614.231 3244.61 608.074 Q3244.61 601.708 3248.03 597.981 Q3251.48 594.231 3257.31 594.231 Q3262.55 594.231 3265.58 597.611 Q3268.63 600.967 3268.63 606.754 M3264.37 605.504 Q3264.33 602.009 3262.41 599.926 Q3260.51 597.842 3257.36 597.842 Q3253.8 597.842 3251.64 599.856 Q3249.51 601.87 3249.19 605.527 L3264.37 605.504 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /></svg>\n"
