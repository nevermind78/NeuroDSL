.3 2505.1 2544.53 2505.65 Q2546.75 2506.21 2549.22 2506.21 Q2553.23 2506.21 2555.57 2504.1 Q2557.91 2502 2557.91 2498.39 Q2557.91 2494.77 2555.57 2492.67 Q2553.23 2490.56 2549.22 2490.56 Q2547.35 2490.56 2545.47 2490.98 Q2543.62 2491.39 2541.68 2492.27 L2541.68 2474.91 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><polyline clip-path=\"url(#clip160)\" style=\"stroke:#000000; stroke-linecap:round; stroke-linejoin:round; stroke-width:4; stroke-opacity:1; fill:none\" points=\"148.959,2439.07 148.959,164.658 \"/>\n",
       "<polyline clip-path=\"url(#clip160)\" style=\"stroke:#000000; stroke-linecap:round; stroke-linejoin:round; stroke-width:4; stroke-opacity:1; fill:none\" points=\"148.959,2097.91 163.717,2097.91 \"/>\n",
       "<polyline clip-path=\"url(#clip160)\" style=\"stroke:#000000; stroke-linecap:round; stroke-linejoin:round; stroke-width:4; stroke-opacity:1; fill:none\" points=\"148.959,1529.31 163.717,1529.31 \"/>\n",
