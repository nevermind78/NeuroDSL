76 Q3122.07 428.37 3119.36 428.37 Q3116.05 428.37 3114.13 430.569 Q3112.21 432.768 3112.21 436.565 L3112.21 451.217 L3107.92 451.217 L3107.92 435.708 Q3107.92 431.958 3106.6 430.176 Q3105.28 428.37 3102.53 428.37 Q3099.27 428.37 3097.34 430.592 Q3095.42 432.792 3095.42 436.565 L3095.42 451.217 L3091.14 451.217 L3091.14 425.292 L3095.42 425.292 L3095.42 429.319 Q3096.88 426.935 3098.92 425.801 Q3100.96 424.667 3103.76 424.667 Q3106.58 424.667 3108.55 426.102 Q3110.54 427.537 3111.49 430.268 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip640)\" d=\"M3159.66 437.19 L3159.66 439.273 L3140.08 439.273 Q3140.35 443.671 3142.71 445.986 Q3145.1 448.278 3149.33 448.278 Q3151.79 448.278 3154.08 447.676 Q3156.4 447.074 3158.66 445.87 L3158.66 449.898 Q3156.37 450.87 3153.96 451.379 Q3151.56 451.889 3149.08 451.889 Q3142.88 451.889 3139.24 448.278 Q3135.63 444.666 3135.63 438.509 Q3135.63 432.143 3139.06 428.417 Q3142.51 424.667 3148.34 424.667 Q3153.57 424.667 3156.6 428.046 Q3159.66 431.403 3159.66 437.19 M3155.4 435.94 Q3155.35 432.444 3153.43 430.361 Q3151.53 428.278 3148.39 428.278 Q3144.82 428.278 3142.67 430.292 Q3140.54 432.305 3140.21 435.963 L3155.4 435.94 M3151.3 413.301 L3155.91 413.301 L3148.36 422.005 L3144.82 422.005 L3151.3 413.301 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip640)\" d=\"M3170.86 417.93 L3170.86 425.292 L3179.64 425.292 L3179.64 428.602 L3170.86 428.602 L3170.86 442.676 Q3170.86 445.847 3171.72 446.75 Q3172.6 447.653 3175.26 447.653 L3179.64 447.653 L3179.64 451.217 L3175.26 451.217 Q3170.33 451.217 3168.46 449.389 Q3166.58 447.537 3166.58 442.676 L3166.58 428.602 L3163.46 428.602 L3163.46 425.292 L3166.58 425.292 L3166.58 417.93 L3170.86 417.93 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip640)\" d=\"M3200.26 429.273 Q3199.54 428.856 3198.69 428.671 Q3197.85 428.463 3196.83 428.463 Q3193.22 428.463 3191.28 430.824 Q3189.36 433.162 3189.36 437.56 L3189.36 451.217 L3185.08 451.217 L3185.08 425.292 L3189.36 425.292 L3189.36 429.319 Q3190.7 426.958 3192.85 425.824 Q3195.01 424.667 3198.08 424.667 Q3198.52 424.667 3199.06 424.736 Q3199.59 424.782 3200.24 424.898 L3200.26 429.273 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip640)\" d=\"M3204.73 425.292 L3208.99 425.292 L3208.99 451.217 L3204.73 451.217 L3204.73 425.292 M3204.73 415.199 L3208.99 415.199 L3208.99 420.592 L3204.73 420.592 L3204.73 415.199 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip640)\" d=\"M3220.45 438.278 Q3220.45 442.977 3222.37 445.662 Q3224.31 448.324 3227.69 448.324 Q3231.07 448.324 3233.02 445.662 Q3234.96 442.977 3234.96 438.278 Q3234.96 433.579 3233.02 430.917 Q3231.07 428.231 3227.69 428.231 Q3224.31 428.231 3222.37 430.917 Q3220.45 433.579 3220.45 438.278 M3234.96 447.328 Q3233.62 449.643 3231.56 450.778 Q3229.52 451.889 3226.65 451.889 Q3221.95 451.889 3218.99 448.139 Q3216.05 444.389 3216.05 438.278 Q3216.05 432.167 3218.99 428.417 Q3221.95 424.667 3226.65 424.667 Q3229.52 424.667 3231.56 425.801 Q3233.62 426.912 3234.96 429.227 L3234.96 425.292 L3239.22 425.292 L3239.22 461.078 L3234.96 461.078 L3234.96 447.328 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip640)\" d=\"M3247.55 440.986 L3247.55 425.292 L3251.81 425.292 L3251.81 440.824 Q3251.81 444.504 3253.25 446.356 Q3254.68 448.185 3257.55 448.185 Q3261 448.185 3262.99 445.986 Q3265.01 443.787 3265.01 439.991 L3265.01 425.292 L3269.26 425.292 L3269.26 451.217 L3265.01 451.217 L3265.01 447.236 Q3263.45 449.597 3261.39 450.754 Q3259.36 451.889 3256.65 451.889 Q3252.18 451.889 3249.87 449.111 Q3247.55 446.333 3247.55 440.986 M3258.27 424.667 L3258.27 424.667 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip640)\" d=\"M3300.21 437.19 L3300.21 439.273 L3280.63 439.273 Q3280.91 443.671 3283.27 445.986 Q3285.65 448.278 3289.89 448.278 Q3292.34 448.278 3294.64 447.676 Q3296.95 447.074 3299.22 445.87 L3299.22 449.898 Q3296.93 450.87 3294.52 451.379 Q3292.11 451.889 3289.64 451.889 Q3283.43 451.889 3279.8 448.278 Q3276.19 444.666 3276.19 438.509 Q3276.19 432.143 3279.61 428.417 Q3283.06 424.667 3288.89 424.667 Q3294.13 424.667 3297.16 428.046 Q3300.21 431.403 3300.21 437.19 M3295.95 435.94 Q3295.91 432.444 3293.99 430.361 Q3292.09 428.278 3288.94 428.278 Q3285.38 428.278 3283.22 430.292 Q3281.09 432.305 3280.77 435.963 L3295.95 435.94 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip640)\" d=\"M3306.53 415.245 L3310.24 415.245 Q3313.71 420.708 3315.42 425.94 Q3317.16 431.171 3317.16 436.333 Q3317.16 441.518 3315.42 446.773 Q3313.71 452.028 3310.24 457.467 L3306.53 457.467 Q3309.61 452.166 3311.12 446.935 Q3312.64 441.68 3312.64 436.333 Q3312.64 430.986 3311.12 425.778 Q3309.61 420.569 3306.53 415.245 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /></svg>\n"
