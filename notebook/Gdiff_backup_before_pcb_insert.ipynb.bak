       "<polyline clip-path=\"url(#clip161)\" style=\"stroke:#000000; stroke-linecap:round; stroke-linejoin:round; stroke-width:2; stroke-opacity:0.1; fill:none\" points=\"148.959,960.704 2650.82,960.704 \"/>\n",
       "<polyline clip-path=\"url(#clip161)\" style=\"stroke:#000000; stroke-linecap:round; stroke-linejoin:round; stroke-width:2; stroke-opacity:0.1; fill:none\" points=\"148.959,392.1 2650.82,392.1 \"/>\n",
       "<polyline clip-path=\"url(#clip160)\" style=\"stroke:#000000; stroke-linecap:round; stroke-linejoin:round; stroke-width:4; stroke-opacity:1; fill:none\" points=\"148.959,2439.07 2650.82,2439.07 \"/>\n",
