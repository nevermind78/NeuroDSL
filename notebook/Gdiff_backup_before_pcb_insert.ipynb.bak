ll=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip160)\" d=\"M3273.2 349.557 L3273.2 351.641 L3253.62 351.641 Q3253.89 356.039 3256.26 358.354 Q3258.64 360.645 3262.88 360.645 Q3265.33 360.645 3267.62 360.043 Q3269.94 359.442 3272.2 358.238 L3272.2 362.266 Q3269.91 363.238 3267.51 363.747 Q3265.1 364.256 3262.62 364.256 Q3256.42 364.256 3252.78 360.645 Q3249.17 357.034 3249.17 350.877 Q3249.17 344.511 3252.6 340.784 Q3256.05 337.034 3261.88 337.034 Q3267.11 337.034 3270.14 340.414 Q3273.2 343.77 3273.2 349.557 M3268.94 348.307 Q3268.89 344.812 3266.97 342.729 Q3265.08 340.645 3261.93 340.645 Q3258.36 340.645 3256.21 342.659 Q3254.08 344.673 3253.76 348.33 L3268.94 348.307 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip160)\" d=\"M3299.89 359.65 L3316.21 359.65 L3316.21 363.585 L3294.26 363.585 L3294.26 359.65 Q3296.93 356.895 3301.51 352.266 Q3306.12 347.613 3307.3 346.27 Q3309.54 343.747 3310.42 342.011 Q3311.32 340.252 3311.32 338.562 Q3311.32 335.807 3309.38 334.071 Q3307.46 332.335 3304.36 332.335 Q3302.16 332.335 3299.7 333.099 Q3297.27 333.863 3294.5 335.414 L3294.5 330.692 Q3297.32 329.557 3299.77 328.979 Q3302.23 328.4 3304.26 328.4 Q3309.64 328.4 3312.83 331.085 Q3316.02 333.77 3316.02 338.261 Q3316.02 340.391 3315.21 342.312 Q3314.43 344.21 3312.32 346.803 Q3311.74 347.474 3308.64 350.692 Q3305.54 353.886 3299.89 359.65 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip160)\" d=\"M2793.21 418.881 L3006.79 418.881 L3006.79 377.409 L2793.21 377.409 L2793.21 418.881  Z\" fill=\"#800080\" fill-rule=\"evenodd\" fill-opacity=\"0.3\"/>\n",
       "<polyline clip-path=\"url(#clip160)\" style=\"stroke:#800080; stroke-linecap:round; stroke-linejoin:round; stroke-width:4; stroke-opacity:0.3; fill:none\" points=\"2793.21,377.409 3006.79,377.409 \"/>\n",
       "<path clip-path=\"url(#clip160)\" d=\"M3042.39 380.865 L3047.07 380.865 L3047.07 415.425 L3042.39 415.425 L3042.39 380.865 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip160)\" d=\"M3076.37 394.476 Q3077.97 391.606 3080.19 390.24 Q3082.41 388.874 3085.42 388.874 Q3089.47 388.874 3091.67 391.721 Q3093.87 394.545 3093.87 399.777 L3093.87 415.425 L3089.59 415.425 L3089.59 399.916 Q3089.59 396.189 3088.27 394.383 Q3086.95 392.578 3084.24 392.578 Q3080.93 392.578 3079.01 394.777 Q3077.09 396.976 3077.09 400.772 L3077.09 415.425 L3072.81 415.425 L3072.81 399.916 Q3072.81 396.166 3071.49 394.383 Q3070.17 392.578 3067.41 392.578 Q3064.15 392.578 3062.23 394.8 Q3060.31 396.999 3060.31 400.772 L3060.31 415.425 L3056.03 415.425 L3056.03 389.499 L3060.31 389.499 L3060.31 393.527 Q3061.77 391.143 3063.8 390.008 Q3065.84 388.874 3068.64 388.874 Q3071.47 388.874 3073.43 390.309 Q3075.42 391.745 3076.37 394.476 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip160)\" d=\"M3122.55 394.476 Q3124.15 391.606 3126.37 390.24 Q3128.59 388.874 3131.6 388.874 Q3135.65 388.874 3137.85 391.721 Q3140.05 394.545 3140.05 399.777 L3140.05 415.425 L3135.77 415.425 L3135.77 399.916 Q3135.77 396.189 3134.45 394.383 Q3133.13 392.578 3130.42 392.578 Q3127.11 392.578 3125.19 394.777 Q3123.27 396.976 3123.27 400.772 L3123.27 415.425 L3118.99 415.425 L3118.99 399.916 Q3118.99 396.166 3117.67 394.383 Q3116.35 392.578 3113.59 392.578 Q3110.33 392.578 3108.41 394.8 Q3106.49 396.999 3106.49 400.772 L3106.49 415.425 L3102.21 415.425 L3102.21 389.499 L3106.49 389.499 L3106.49 393.527 Q3107.95 391.143 3109.98 390.008 Q3112.02 388.874 3114.82 388.874 Q3117.65 388.874 3119.61 390.309 Q3121.6 391.745 3122.55 394.476 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip160)\" d=\"M3170.72 401.397 L3170.72 403.481 L3151.14 403.481 Q3151.42 407.879 3153.78 410.194 Q3156.16 412.485 3160.4 412.485 Q3162.85 412.485 3165.15 411.883 Q3167.46 411.282 3169.73 410.078 L3169.73 414.106 Q3167.44 415.078 3165.03 415.587 Q3162.62 416.096 3160.15 416.096 Q3153.94 416.096 3150.31 412.485 Q3146.7 408.874 3146.7 402.717 Q3146.7 396.351 3150.12 392.624 Q3153.57 388.874 3159.4 388.874 Q3164.64 388.874 3167.67 392.254 Q3170.72 395.61 3170.72 401.397 M3166.46 400.147 Q3166.42 396.652 3164.5 394.569 Q3162.6 392.485 3159.45 392.485 Q3155.89 392.485 3153.73 394.499 Q3151.6 396.513 3151.28 400.17 L3166.46 400.147 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip160)\" d=\"M3177.27 405.194 L3177.27 389.499 L3181.53 389.499 L3181.53 405.032 Q3181.53 408.712 3182.97 410.564 Q3184.4 412.393 3187.27 412.393 Q3190.72 412.393 3192.71 410.194 Q3194.73 407.994 3194.73 404.198 L3194.73 389.499 L3198.99 389.499 L3198.99 415.425 L3194.73 415.425 L3194.73 411.444 Q3193.18 413.805 3191.12 414.962 Q3189.08 416.096 3186.37 416.096 Q3181.9 416.096 3179.59 413.319 Q3177.27 410.541 3177.27 405.194 M3187.99 388.874 L3187.99 388.874 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip160)\" d=\"M3226.37 402.485 Q3226.37 397.786 3224.43 395.124 Q3222.51 392.439 3219.13 392.439 Q3215.75 392.439 3213.8 395.124 Q3211.88 397.786 3211.88 402.485 Q3211.88 407.184 3213.8 409.869 Q3215.75 412.531 3219.13 412.531 Q3222.51 412.531 3224.43 409.869 Q3226.37 407.184 3226.37 402.485 M3211.88 393.434 Q3213.22 391.12 3215.26 390.008 Q3217.32 388.874 3220.17 388.874 Q3224.89 388.874 3227.83 392.624 Q3230.79 396.374 3230.79 402.485 Q3230.79 408.596 3227.83 412.346 Q3224.89 416.096 3220.17 416.096 Q3217.32 416.096 3215.26 414.985 Q3213.22 413.851 3211.88 411.536 L3211.88 415.425 L3207.6 415.425 L3207.6 379.407 L3211.88 379.407 L3211.88 393.434 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip160)\" d=\"M3237.85 379.407 L3242.11 379.407 L3242.11 415.425 L3237.85 415.425 L3237.85 379.407 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip160)\" d=\"M3273.2 401.397 L3273.2 403.481 L3253.62 403.481 Q3253.89 407.879 3256.26 410.194 Q3258.64 412.485 3262.88 412.485 Q3265.33 412.485 3267.62 411.883 Q3269.94 411.282 3272.2 410.078 L3272.2 414.106 Q3269.91 415.078 3267.51 415.587 Q3265.1 416.096 3262.62 416.096 Q3256.42 416.096 3252.78 412.485 Q3249.17 408.874 3249.17 402.717 Q3249.17 396.351 3252.6 392.624 Q3256.05 388.874 3261.88 388.874 Q3267.11 388.874 3270.14 392.254 Q3273.2 395.61 3273.2 401.397 M3268.94 400.147 Q3268.89 396.652 3266.97 394.569 Q3265.08 392.485 3261.93 392.485 Q3258.36 392.485 3256.21 394.499 Q3254.08 396.513 3253.76 400.17 L3268.94 400.147 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip160)\" d=\"M3310.03 396.791 Q3313.39 397.508 3315.26 399.777 Q3317.16 402.045 3317.16 405.379 Q3317.16 410.494 3313.64 413.295 Q3310.12 416.096 3303.64 416.096 Q3301.46 416.096 3299.15 415.656 Q3296.86 415.24 3294.4 414.383 L3294.4 409.869 Q3296.35 411.004 3298.66 411.582 Q3300.98 412.161 3303.5 412.161 Q3307.9 412.161 3310.19 410.425 Q3312.51 408.689 3312.51 405.379 Q3312.51 402.323 3310.35 400.61 Q3308.22 398.874 3304.4 398.874 L3300.38 398.874 L3300.38 395.032 L3304.59 395.032 Q3308.04 395.032 3309.87 393.666 Q3311.7 392.277 3311.7 389.684 Q3311.7 387.022 3309.8 385.61 Q3307.92 384.175 3304.4 384.175 Q3302.48 384.175 3300.28 384.592 Q3298.08 385.008 3295.45 385.888 L3295.45 381.721 Q3298.11 380.981 3300.42 380.61 Q3302.76 380.24 3304.82 380.24 Q3310.14 380.24 3313.25 382.671 Q3316.35 385.078 3316.35 389.198 Q3316.35 392.069 3314.7 394.059 Q3313.06 396.027 3310.03 396.791 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /></svg>\n"
