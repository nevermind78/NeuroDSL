ll=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip850)\" d=\"M3273.2 349.557 L3273.2 351.641 L3253.62 351.641 Q3253.89 356.039 3256.26 358.354 Q3258.64 360.645 3262.88 360.645 Q3265.33 360.645 3267.62 360.043 Q3269.94 359.442 3272.2 358.238 L3272.2 362.266 Q3269.91 363.238 3267.51 363.747 Q3265.1 364.256 3262.62 364.256 Q3256.42 364.256 3252.78 360.645 Q3249.17 357.034 3249.17 350.877 Q3249.17 344.511 3252.6 340.784 Q3256.05 337.034 3261.88 337.034 Q3267.11 337.034 3270.14 340.414 Q3273.2 343.77 3273.2 349.557 M3268.94 348.307 Q3268.89 344.812 3266.97 342.729 Q3265.08 340.645 3261.93 340.645 Q3258.36 340.645 3256.21 342.659 Q3254.08 344.673 3253.76 348.33 L3268.94 348.307 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip850)\" d=\"M3299.89 359.65 L3316.21 359.65 L3316.21 363.585 L3294.26 363.585 L3294.26 359.65 Q3296.93 356.895 3301.51 352.266 Q3306.12 347.613 3307.3 346.27 Q3309.54 343.747 3310.42 342.011 Q3311.32 340.252 3311.32 338.562 Q3311.32 335.807 3309.38 334.071 Q3307.46 332.335 3304.36 332.335 Q3302.16 332.335 3299.7 333.099 Q3297.27 333.863 3294.5 335.414 L3294.5 330.692 Q3297.32 329.557 3299.77 328.979 Q3302.23 328.4 3304.26 328.4 Q3309.64 328.4 3312.83 331.085 Q3316.02 333.77 3316.02 338.261 Q3316.02 340.391 3315.21 342.312 Q3314.43 344.21 3312.32 346.803 Q3311.74 347.474 3308.64 350.692 Q3305.54 353.886 3299.89 359.65 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip850)\" d=\"M2793.21 418.881 L3006.79 418.881 L3006.79 377.409 L2793.21 377.409 L2793.21 418.881  Z\" fill=\"#800080\" fill-rule=\"evenodd\" fill-opacity=\"0.3\"/>\n",
