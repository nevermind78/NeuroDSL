       "<polyline clip-path=\"url(#clip661)\" style=\"stroke:#000000; stroke-linecap:round; stroke-linejoin:round; stroke-width:2; stroke-opacity:0.1; fill:none\" points=\"148.959,1529.31 2650.82,1529.31 \"/>\n",
       "<polyline clip-path=\"url(#clip661)\" style=\"stroke:#000000; stroke-linecap:round; stroke-linejoin:round; stroke-width:2; stroke-opacity:0.1; fill:none\" points=\"148.959,960.704 2650.82,960.704 \"/>\n",
