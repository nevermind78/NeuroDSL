\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip760)\" d=\"M3260.79 317.265 L3260.79 319.349 L3241.2 319.349 Q3241.48 323.747 3243.84 326.061 Q3246.23 328.353 3250.46 328.353 Q3252.92 328.353 3255.21 327.751 Q3257.52 327.149 3259.79 325.946 L3259.79 329.973 Q3257.5 330.946 3255.09 331.455 Q3252.69 331.964 3250.21 331.964 Q3244 331.964 3240.37 328.353 Q3236.76 324.742 3236.76 318.585 Q3236.76 312.219 3240.19 308.492 Q3243.63 304.742 3249.47 304.742 Q3254.7 304.742 3257.73 308.122 Q3260.79 311.478 3260.79 317.265 M3256.53 316.015 Q3256.48 312.52 3254.56 310.437 Q3252.66 308.353 3249.51 308.353 Q3245.95 308.353 3243.8 310.367 Q3241.67 312.381 3241.34 316.038 L3256.53 316.015 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip760)\" d=\"M3287.48 327.358 L3303.8 327.358 L3303.8 331.293 L3281.85 331.293 L3281.85 327.358 Q3284.51 324.603 3289.1 319.974 Q3293.7 315.321 3294.88 313.978 Q3297.13 311.455 3298.01 309.719 Q3298.91 307.96 3298.91 306.27 Q3298.91 303.515 3296.97 301.779 Q3295.05 300.043 3291.94 300.043 Q3289.74 300.043 3287.29 300.807 Q3284.86 301.571 3282.08 303.122 L3282.08 298.4 Q3284.91 297.265 3287.36 296.687 Q3289.81 296.108 3291.85 296.108 Q3297.22 296.108 3300.42 298.793 Q3303.61 301.478 3303.61 305.969 Q3303.61 308.099 3302.8 310.02 Q3302.01 311.918 3299.91 314.511 Q3299.33 315.182 3296.23 318.399 Q3293.12 321.594 3287.48 327.358 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip760)\" d=\"M2781.5 386.589 L2994.48 386.589 L2994.48 345.117 L2781.5 345.117 L2781.5 386.589  Z\" fill=\"#800080\" fill-rule=\"evenodd\" fill-opacity=\"0.3\"/>\n",
       "<polyline clip-path=\"url(#clip760)\" style=\"stroke:#800080; stroke-linecap:round; stroke-linejoin:round; stroke-width:4; stroke-opacity:0.3; fill:none\" points=\"2781.5,345.117 2994.48,345.117 \"/>\n",
       "<path clip-path=\"url(#clip760)\" d=\"M3029.98 348.573 L3034.65 348.573 L3034.65 383.133 L3029.98 383.133 L3029.98 348.573 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip760)\" d=\"M3063.96 362.184 Q3065.56 359.314 3067.78 357.948 Q3070 356.582 3073.01 356.582 Q3077.06 356.582 3079.26 359.429 Q3081.46 362.253 3081.46 367.485 L3081.46 383.133 L3077.18 383.133 L3077.18 367.624 Q3077.18 363.897 3075.86 362.091 Q3074.54 360.286 3071.83 360.286 Q3068.52 360.286 3066.6 362.485 Q3064.68 364.684 3064.68 368.48 L3064.68 383.133 L3060.39 383.133 L3060.39 367.624 Q3060.39 363.874 3059.07 362.091 Q3057.76 360.286 3055 360.286 Q3051.74 360.286 3049.82 362.508 Q3047.89 364.707 3047.89 368.48 L3047.89 383.133 L3043.61 383.133 L3043.61 357.207 L3047.89 357.207 L3047.89 361.235 Q3049.35 358.851 3051.39 357.716 Q3053.43 356.582 3056.23 356.582 Q3059.05 356.582 3061.02 358.017 Q3063.01 359.452 3063.96 362.184 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip760)\" d=\"M3110.14 362.184 Q3111.74 359.314 3113.96 357.948 Q3116.18 356.582 3119.19 356.582 Q3123.24 356.582 3125.44 359.429 Q3127.64 362.253 3127.64 367.485 L3127.64 383.133 L3123.36 383.133 L3123.36 367.624 Q3123.36 363.897 3122.04 362.091 Q3120.72 360.286 3118.01 360.286 Q3114.7 360.286 3112.78 362.485 Q3110.86 364.684 3110.86 368.48 L3110.86 383.133 L3106.57 383.133 L3106.57 367.624 Q3106.57 363.874 3105.26 362.091 Q3103.94 360.286 3101.18 360.286 Q3097.92 360.286 3096 362.508 Q3094.07 364.707 3094.07 368.48 L3094.07 383.133 L3089.79 383.133 L3089.79 357.207 L3094.07 357.207 L3094.07 361.235 Q3095.53 358.851 3097.57 357.716 Q3099.61 356.582 3102.41 356.582 Q3105.23 356.582 3107.2 358.017 Q3109.19 359.452 3110.14 362.184 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip760)\" d=\"M3158.31 369.105 L3158.31 371.189 L3138.73 371.189 Q3139.01 375.587 3141.37 377.901 Q3143.75 380.193 3147.99 380.193 Q3150.44 380.193 3152.73 379.591 Q3155.05 378.989 3157.32 377.786 L3157.32 381.813 Q3155.02 382.786 3152.62 383.295 Q3150.21 383.804 3147.73 383.804 Q3141.53 383.804 3137.89 380.193 Q3134.28 376.582 3134.28 370.425 Q3134.28 364.059 3137.71 360.332 Q3141.16 356.582 3146.99 356.582 Q3152.22 356.582 3155.25 359.962 Q3158.31 363.318 3158.31 369.105 M3154.05 367.855 Q3154 364.36 3152.08 362.277 Q3150.19 360.193 3147.04 360.193 Q3143.47 360.193 3141.32 362.207 Q3139.19 364.221 3138.87 367.878 L3154.05 367.855 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip760)\" d=\"M3164.86 372.901 L3164.86 357.207 L3169.12 357.207 L3169.12 372.739 Q3169.12 376.42 3170.56 378.272 Q3171.99 380.1 3174.86 380.1 Q3178.31 380.1 3180.3 377.901 Q3182.32 375.702 3182.32 371.906 L3182.32 357.207 L3186.57 357.207 L3186.57 383.133 L3182.32 383.133 L3182.32 379.151 Q3180.76 381.513 3178.7 382.67 Q3176.67 383.804 3173.96 383.804 Q3169.49 383.804 3167.18 381.026 Q3164.86 378.249 3164.86 372.901 M3175.58 356.582 L3175.58 356.582 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip760)\" d=\"M3213.96 370.193 Q3213.96 365.494 3212.01 362.832 Q3210.09 360.147 3206.71 360.147 Q3203.33 360.147 3201.39 362.832 Q3199.47 365.494 3199.47 370.193 Q3199.47 374.892 3201.39 377.577 Q3203.33 380.239 3206.71 380.239 Q3210.09 380.239 3212.01 377.577 Q3213.96 374.892 3213.96 370.193 M3199.47 361.142 Q3200.81 358.827 3202.85 357.716 Q3204.91 356.582 3207.75 356.582 Q3212.48 356.582 3215.42 360.332 Q3218.38 364.082 3218.38 370.193 Q3218.38 376.304 3215.42 380.054 Q3212.48 383.804 3207.75 383.804 Q3204.91 383.804 3202.85 382.693 Q3200.81 381.559 3199.47 379.244 L3199.47 383.133 L3195.19 383.133 L3195.19 347.115 L3199.47 347.115 L3199.47 361.142 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip760)\" d=\"M3225.44 347.115 L3229.7 347.115 L3229.7 383.133 L3225.44 383.133 L3225.44 347.115 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip760)\" d=\"M3260.79 369.105 L3260.79 371.189 L3241.2 371.189 Q3241.48 375.587 3243.84 377.901 Q3246.23 380.193 3250.46 380.193 Q3252.92 380.193 3255.21 379.591 Q3257.52 378.989 3259.79 377.786 L3259.79 381.813 Q3257.5 382.786 3255.09 383.295 Q3252.69 383.804 3250.21 383.804 Q3244 383.804 3240.37 380.193 Q3236.76 376.582 3236.76 370.425 Q3236.76 364.059 3240.19 360.332 Q3243.63 356.582 3249.47 356.582 Q3254.7 356.582 3257.73 359.962 Q3260.79 363.318 3260.79 369.105 M3256.53 367.855 Q3256.48 364.36 3254.56 362.277 Q3252.66 360.193 3249.51 360.193 Q3245.95 360.193 3243.8 362.207 Q3241.67 364.221 3241.34 367.878 L3256.53 367.855 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip760)\" d=\"M3297.62 364.499 Q3300.97 365.216 3302.85 367.485 Q3304.74 369.753 3304.74 373.087 Q3304.74 378.202 3301.23 381.003 Q3297.71 383.804 3291.23 383.804 Q3289.05 383.804 3286.74 383.364 Q3284.44 382.948 3281.99 382.091 L3281.99 377.577 Q3283.93 378.712 3286.25 379.29 Q3288.56 379.869 3291.09 379.869 Q3295.49 379.869 3297.78 378.133 Q3300.09 376.397 3300.09 373.087 Q3300.09 370.031 3297.94 368.318 Q3295.81 366.582 3291.99 366.582 L3287.96 366.582 L3287.96 362.739 L3292.18 362.739 Q3295.62 362.739 3297.45 361.374 Q3299.28 359.985 3299.28 357.392 Q3299.28 354.73 3297.38 353.318 Q3295.51 351.883 3291.99 351.883 Q3290.07 351.883 3287.87 352.3 Q3285.67 352.716 3283.03 353.596 L3283.03 349.429 Q3285.69 348.689 3288.01 348.318 Q3290.35 347.948 3292.41 347.948 Q3297.73 347.948 3300.83 350.378 Q3303.93 352.786 3303.93 356.906 Q3303.93 359.777 3302.29 361.767 Q3300.65 363.735 3297.62 364.499 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /></svg>\n"
