       "<path clip-path=\"url(#clip850)\" d=\"M3042.39 380.865 L3047.07 380.865 L3047.07 415.425 L3042.39 415.425 L3042.39 380.865 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip850)\" d=\"M3076.37 394.476 Q3077.97 391.606 3080.19 390.24 Q3082.41 388.874 3085.42 388.874 Q3089.47 388.874 3091.67 391.721 Q3093.87 394.545 3093.87 399.777 L3093.87 415.425 L3089.59 415.425 L3089.59 399.916 Q3089.59 396.189 3088.27 394.383 Q3086.95 392.578 3084.24 392.578 Q3080.93 392.578 3079.01 394.777 Q3077.09 396.976 3077.09 400.772 L3077.09 415.425 L3072.81 415.425 L3072.81 399.916 Q3072.81 396.166 3071.49 394.383 Q3070.17 392.578 3067.41 392.578 Q3064.15 392.578 3062.23 394.8 Q3060.31 396.999 3060.31 400.772 L3060.31 415.425 L3056.03 415.425 L3056.03 389.499 L3060.31 389.499 L3060.31 393.527 Q3061.77 391.143 3063.8 390.008 Q3065.84 388.874 3068.64 388.874 Q3071.47 388.874 3073.43 390.309 Q3075.42 391.745 3076.37 394.476 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip850)\" d=\"M3122.55 394.476 Q3124.15 391.606 3126.37 390.24 Q3128.59 388.874 3131.6 388.874 Q3135.65 388.874 3137.85 391.721 Q3140.05 394.545 3140.05 399.777 L3140.05 415.425 L3135.77 415.425 L3135.77 399.916 Q3135.77 396.189 3134.45 394.383 Q3133.13 392.578 3130.42 392.578 Q3127.11 392.578 3125.19 394.777 Q3123.27 396.976 3123.27 400.772 L3123.27 415.425 L3118.99 415.425 L3118.99 399.916 Q3118.99 396.166 3117.67 394.383 Q3116.35 392.578 3113.59 392.578 Q3110.33 392.578 3108.41 394.8 Q3106.49 396.999 3106.49 400.772 L3106.49 415.425 L3102.21 415.425 L3102.21 389.499 L3106.49 389.499 L3106.49 393.527 Q3107.95 391.143 3109.98 390.008 Q3112.02 388.874 3114.82 388.874 Q3117.65 388.874 3119.61 390.309 Q3121.6 391.745 3122.55 394.476 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip850)\" d=\"M3170.72 401.397 L3170.72 403.481 L3151.14 403.481 Q3151.42 407.879 3153.78 410.194 Q3156.16 412.485 3160.4 412.485 Q3162.85 412.485 3165.15 411.883 Q3167.46 411.282 3169.73 410.078 L3169.73 414.106 Q3167.44 415.078 3165.03 415.587 Q3162.62 416.096 3160.15 416.096 Q3153.94 416.096 3150.31 412.485 Q3146.7 408.874 3146.7 402.717 Q3146.7 396.351 3150.12 392.624 Q3153.57 388.874 3159.4 388.874 Q3164.64 388.874 3167.67 392.254 Q3170.72 395.61 3170.72 401.397 M3166.46 400.147 Q3166.42 396.652 3164.5 394.569 Q3162.6 392.485 3159.45 392.485 Q3155.89 392.485 3153.73 394.499 Q3151.6 396.513 3151.28 400.17 L3166.46 400.147 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip850)\" d=\"M3177.27 405.194 L3177.27 389.499 L3181.53 389.499 L3181.53 405.032 Q3181.53 408.712 3182.97 410.564 Q3184.4 412.393 3187.27 412.393 Q3190.72 412.393 3192.71 410.194 Q3194.73 407.994 3194.73 404.198 L3194.73 389.499 L3198.99 389.499 L3198.99 415.425 L3194.73 415.425 L3194.73 411.444 Q3193.18 413.805 3191.12 414.962 Q3189.08 416.096 3186.37 416.096 Q3181.9 416.096 3179.59 413.319 Q3177.27 410.541 3177.27 405.194 M3187.99 388.874 L3187.99 388.874 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip850)\" d=\"M3226.37 402.485 Q3226.37 397.786 3224.43 395.124 Q3222.51 392.439 3219.13 392.439 Q3215.75 392.439 3213.8 395.124 Q3211.88 397.786 3211.88 402.485 Q3211.88 407.184 3213.8 409.869 Q3215.75 412.531 3219.13 412.531 Q3222.51 412.531 3224.43 409.869 Q3226.37 407.184 3226.37 402.485 M3211.88 393.434 Q3213.22 391.12 3215.26 390.008 Q3217.32 388.874 3220.17 388.874 Q3224.89 388.874 3227.83 392.624 Q3230.79 396.374 3230.79 402.485 Q3230.79 408.596 3227.83 412.346 Q3224.89 416.096 3220.17 416.096 Q3217.32 416.096 3215.26 414.985 Q3213.22 413.851 3211.88 411.536 L3211.88 415.425 L3207.6 415.425 L3207.6 379.407 L3211.88 379.407 L3211.88 393.434 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip850)\" d=\"M3237.85 379.407 L3242.11 379.407 L3242.11 415.425 L3237.85 415.425 L3237.85 379.407 Z\" fi