    "# =======================================================================\n",
    "# CELLULE 9 : Autopsie de la Matrice de Greffe (W_rec)\n",
    "# =======================================================================\n",
    "W_finale = node(g2, :W_rec).value\n",
    "\n",
    "println(\"=== CARTE DES CONNEXIONS SYNAPTIQUES (W_rec) ===\")\n",
    "# On arrondit à 3 décimales pour y voir plus clair\n",
    "display(round.(W_finale, digits=3))"
   ]
