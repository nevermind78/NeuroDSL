.59 539.693 Q3139.38 539.693 3135.75 536.082 Q3132.14 532.471 3132.14 526.313 Q3132.14 519.947 3135.56 516.221 Q3139.01 512.471 3144.85 512.471 Q3150.08 512.471 3153.11 515.85 Q3156.17 519.207 3156.17 524.994 M3151.91 523.744 Q3151.86 520.248 3149.94 518.165 Q3148.04 516.082 3144.89 516.082 Q3141.33 516.082 3139.18 518.096 Q3137.05 520.11 3136.72 523.767 L3151.91 523.744 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip900)\" d=\"M3196.88 514.091 L3196.88 518.073 Q3195.08 517.077 3193.25 516.591 Q3191.44 516.082 3189.59 516.082 Q3185.45 516.082 3183.16 518.721 Q3180.87 521.336 3180.87 526.082 Q3180.87 530.827 3183.16 533.466 Q3185.45 536.082 3189.59 536.082 Q3191.44 536.082 3193.25 535.596 Q3195.08 535.086 3196.88 534.091 L3196.88 538.026 Q3195.1 538.859 3193.18 539.276 Q3191.28 539.693 3189.13 539.693 Q3183.27 539.693 3179.82 536.012 Q3176.37 532.332 3176.37 526.082 Q3176.37 519.739 3179.85 516.105 Q3183.34 512.471 3189.41 512.471 Q3191.37 512.471 3193.25 512.887 Q3195.12 513.281 3196.88 514.091 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip900)\" d=\"M3203.85 528.79 L3203.85 513.096 L3208.11 513.096 L3208.11 528.628 Q3208.11 532.309 3209.55 534.16 Q3210.98 535.989 3213.85 535.989 Q3217.3 535.989 3219.29 533.79 Q3221.3 531.591 3221.3 527.795 L3221.3 513.096 L3225.56 513.096 L3225.56 539.021 L3221.3 539.021 L3221.3 535.04 Q3219.75 537.401 3217.69 538.559 Q3215.66 539.693 3212.95 539.693 Q3208.48 539.693 3206.17 536.915 Q3203.85 534.137 3203.85 528.79 M3214.57 512.471 L3214.57 512.471 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip900)\" d=\"M3234.34 513.096 L3238.6 513.096 L3238.6 539.021 L3234.34 539.021 L3234.34 513.096 M3234.34 503.003 L3238.6 503.003 L3238.6 508.397 L3234.34 508.397 L3234.34 503.003 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip900)\" d=\"M3244.45 513.096 L3248.97 513.096 L3257.07 534.855 L3265.17 513.096 L3269.68 513.096 L3259.96 539.021 L3254.17 539.021 L3244.45 513.096 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip900)\" d=\"M3290.59 517.077 Q3289.87 516.66 3289.01 516.475 Q3288.18 516.267 3287.16 516.267 Q3283.55 516.267 3281.61 518.628 Q3279.68 520.966 3279.68 525.364 L3279.68 539.021 L3275.4 539.021 L3275.4 513.096 L3279.68 513.096 L3279.68 517.123 Q3281.03 514.762 3283.18 513.628 Q3285.33 512.471 3288.41 512.471 Q3288.85 512.471 3289.38 512.54 Q3289.92 512.586 3290.56 512.702 L3290.59 517.077 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /><path clip-path=\"url(#clip900)\" d=\"M3316.19 524.994 L3316.19 527.077 L3296.61 527.077 Q3296.88 531.475 3299.24 533.79 Q3301.63 536.082 3305.86 536.082 Q3308.32 536.082 3310.61 535.48 Q3312.92 534.878 3315.19 533.674 L3315.19 537.702 Q3312.9 538.674 3310.49 539.184 Q3308.09 539.693 3305.61 539.693 Q3299.41 539.693 3295.77 536.082 Q3292.16 532.471 3292.16 526.313 Q3292.16 519.947 3295.59 516.221 Q3299.04 512.471 3304.87 512.471 Q3310.1 512.471 3313.13 515.85 Q3316.19 519.207 3316.19 524.994 M3311.93 523.744 Q3311.88 520.248 3309.96 518.165 Q3308.06 516.082 3304.92 516.082 Q3301.35 516.082 3299.2 518.096 Q3297.07 520.11 3296.74 523.767 L3311.93 523.744 Z\" fill=\"#000000\" fill-rule=\"nonzero\" fill-opacity=\"1\" /></svg>\n"
