     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ Piste PCB routée : plus courte possible, sans virage inutile, hors des composants.\n"
     ]
    }
   ],
   "source": [
    "# =======================================================================\n",
    "# CELLULE 13 : ROUTAGE DE PISTE PCB PAR DESCENTE DE GRADIENT\n",
    "# =======================================================================\n",
    "# Adaptation directe du moteur physique du drone (Cellule Unifiée V4) au\n",
    "# routage de pistes sur une carte électronique : trouver le meilleur chemin\n",
    "# entre deux pastilles (pads) en évitant les zones d'exclusion des composants\n",
    "# (footprints RECTANGULAIRES, pas des cercles) tout en pénalisant les virages\n",
    "# trop serrés -- une piste de cuivre réelle résiste à la flexion, contrairement\n",
    "# à un simple élastique, d'où le terme de \"rigidité\" ajouté par rapport au drone.\n",
    "using LinearAlgebra, Plots, IJulia\n",
    "using NeuroDSL\n",
    "\n",
    "println(\"=== COMPILATION DU MOTEUR DE ROUTAGE PCB ===\")\n",
    "\n",
    "# 🛠️ PANNEAU DE CONFIGURATION DU ROUTAGE 🛠️\n",
    "PAD_START = Float32[2.0, 2.0]   # Pastille de départ (ex. broche du connecteur)\n",
    "PAD_END   = Float32[38.0, 34.0] # Pastille d'arrivée (ex. broche du microcontrôleur)\n",
    "\n",
    "# Zones d'exclusion : chaque composant est un rectangle (cx, cy, demi-largeur, demi-hauteur)\n",
    "composants = [\n",
    "    (12.0f0, 18.0f0, 5.0f0, 6.0f0),   # Gros composant central (ex. condensateur)\n",
    "    (25.0f0, 8.0f0,  4.0f0, 3.0f0),   # Petit composant CMS en bas\n",
    "    (28.0f0, 26.0f0, 6.0f0, 4.0f0),   # Circuit intégré à droite\n",
    "]\n",
    "MARGE_ISOLATION = 0.6f0   # Clearance mini (largeur de piste + isolation)\n",
    "RAIDEUR_VIRAGE  = 0.35f0  # Rigidité anti-virage-serré (0 = élastique pur, comme le drone)\n",
    "FORCE_EXCLUSION = 300.0f0 # Intensité de la répulsion des zones interdites\n",
    "\n",
    "# 1. DÉFINITION DE L'OPÉRATEUR PHYSIQUE\n",
    "register_op!(:pcb_trace_optimizer, (dev, out, inputs, attrs, out_sym, out_node, ctx) -> begin\n",
    "    W = inputs[1] # Waypoints intermédiaires de la piste, (N, 2)\n",
    "    N = size(W, 1)\n",
    "\n",
    "    S = PAD_START\n",
    "    E = PAD_END\n",
    "\n",
    "    loss = 0.0f0\n",
    "\n",
    "    # FORCE 1 : TENSION -- raccourcit la piste (moins de cuivre, moins de résistance)\n",
    "    loss += sum((W[1, :] .- S).^2)\n",
    "    for i in 1:N-1\n",
    "        loss += sum((W[i+1, :] .- W[i, :]).^2)\n",
    "    end\n",
    "    loss += sum((E .- W[N, :]).^2)\n",
    "\n",
    "    # FORCE 2 : RIGIDITÉ -- pénalise les virages serrés (dérivée seconde discrète)\n",
    "    if N >= 3\n",
    "        for i in 2:N-1\n",
    "            Dcourb = W[i+1, :] .- 2.0f0 .* W[i, :] .+ W[i-1, :]\n",
    "            loss += RAIDEUR_VIRAGE * sum(Dcourb.^2)\n",
    "        end\n",
    "    end\n",
    "\n",
    "    # FORCE 3 : EXCLUSION -- repousse la piste hors des footprints de composants\n",
    "    for (cx, cy, hx, hy) in composants\n",
    "        Hx = hx + MARGE_ISOLATION\n",
    "        Hy = hy + MARGE_ISOLATION\n",
    "        for i in 1:N\n",
    "            dx = W[i, 1] - cx\n",
    "            dy = W[i, 2] - cy\n",
    "            if abs(dx) < Hx && abs(dy) < Hy\n",
    "                loss += FORCE_EXCLUSION * ((Hx - abs(dx))^2 + (Hy - abs(dy))^2)\n",
    "            end\n",
    "        end\n",
    "    end\n",
    "\n",
    "    out .= loss\n",
    "    if ctx !== nothing\n",
    "        ctx[out_sym] = Dict(:W => W, :S => S, :E => E, :N => N, :composants => composants,\n",
    "                             :marge => MARGE_ISOLATION, :raideur => RAIDEUR_VIRAGE, :force => FORCE_EXCLUSION)\n",
    "    end\n",
    "end)\n",
    "\n",
    "CUSTOM_SHAPE_RULES[:pcb_trace_optimizer] = (inputs, attrs) -> (1, 1)\n",
    "\n",
    "# Le calcul exact de la dérivée (le gradient = la force physique qui pousse chaque point)\n",
    "GRAD_RULES[:pcb_trace_optimizer] = (dev, dy, ctx, inputs) -> begin\n",
    "    W = ctx[:W]; S = ctx[:S]; E = ctx[:E]; N = ctx[:N]\n",
    "    composants = ctx[:composants]; MARGE = ctx[:marge]\n",
    "    RAIDEUR = ctx[:raideur]; FORCE = ctx[:force]\n",
    "\n",
    "    grad_W = zeros(Float32, N, 2)\n",
    "\n",
    "    # Dérivée de la tension (tire chaque point vers ses voisins/ancrages)\n",
    "    grad_W[1, :] .+= 2.0f0 .* (W[1, :] .- S) .- 2.0f0 .* (W[2, :] .- W[1, :])\n",
    "    for i in 2:N-1\n",
    "        grad_W[i, :] .+= 2.0f0 .* (W[i, :] .- W[i-1, :]) .- 2.0f0 .* (W[i+1, :] .- W[i, :])\n",
    "    end\n",
    "    grad_W[N, :] .+= 2.0f0 .* (W[N, :] .- W[N-1, :]) .- 2.0f0 .* (E .- W[N, :])\n",
    "\n",
    "    # Dérivée de la rigidité anti-virage (diffusée sur les 3 points voisins)\n",
    "    if N >= 3\n",
    "        for i in 2:N-1\n",
    "            Dcourb = W[i+1, :] .- 2.0f0 .* W[i, :] .+ W[i-1, :]\n",
    "            grad_W[i-1, :] .+= 2.0f0 * RAIDEUR .* Dcourb\n",
    "            grad_W[i,   :] .+= -4.0f0 * RAIDEUR .* Dcourb\n",
    "            grad_W[i+1, :] .+= 2.0f0 * RAIDEUR .* Dcourb\n",
    "        end\n",
    "    end\n",
    "\n",
    "    # Dérivée de l'exclusion (pousse hors du rectangle élargi, axe par axe)\n",
    "    for (cx, cy, hx, hy) in composants\n",
    "        Hx = hx + MARGE\n",
    "        Hy = hy + MARGE\n",
    "        for i in 1:N\n",
    "            dx = W[i, 1] - cx\n",
    "            dy = W[i, 2] - cy\n",
    "            if abs(dx) < Hx && abs(dy) < Hy\n",
    "                grad_W[i, 1] += FORCE * 2.0f0 * (Hx - abs(dx)) * (-sign(dx))\n",
    "                grad_W[i, 2] += FORCE * 2.0f0 * (Hy - abs(dy)) * (-sign(dy))\n",
    "            end\n",
    "        end\n",
    "    end\n",
    "\n",
    "    return (grad_W .* dy[1], )\n",
    "end\n",
    "\n",
    "println(\"✅ Moteur de routage PCB intégré. Prêt pour l'optimisation.\")\n",
    "\n",
    "# 2. INITIALISATION ET GRAPHE\n",
    "g_pcb = NeuroGraph(device=Backend.CPUDevice())\n",
    "N_waypoints = 20\n",
    "\n",
    "W_init = zeros(Float32, N_waypoints, 2)\n",
    "for i in 1:N_waypoints\n",
    "    fraction = Float32(i) / Float32(N_waypoints + 1)\n",
    "    W_init[i, 1] = PAD_START[1] + (PAD_END[1] - PAD_START[1]) * fraction\n",
    "    W_init[i, 2] = PAD_START[2] + (PAD_END[2] - PAD_START[2]) * fraction\n",
    "end\n",
    "\n",
    "set!(g_pcb, :waypoints, W_init; is_param=true)\n",
    "addrule!(g_pcb, GraphRule(:loss, [:waypoints], :pcb_trace_optimizer))\n",
    "\n",
    "# 3. BOUCLE D'OPTIMISATION & ANIMATION\n",
    "epochs = 1200\n",
    "lr_route = 4f-3\n",
    "\n",
    "rectangle_pts(cx, cy, hx, hy) = ([cx-hx, cx+hx, cx+hx, cx-hx, cx-hx], [cy-hy, cy-hy, cy+hy, cy+hy, cy-hy])\n",
    "\n",
    "for epoch in 1:epochs\n",
    "    p_node = node(g_pcb, :waypoints)\n",
    "    p_node.gradient = nothing\n",
    "\n",
    "    zero_grads!(g_pcb)\n",
    "    demand!(g_pcb, :loss)\n",
    "    backward_graph!(g_pcb, :loss)\n",
    "\n",
    "    if p_node.gradient !== nothing\n",
    "        grad_clipped = clamp.(p_node.gradient, -20.0f0, 20.0f0)\n",
    "\n",
    "        current_lr = lr_route * (1.0f0 - (Float32(epoch)/Float32(epochs))^2)\n",
    "        current_lr = max(current_lr, 1f-4)\n",
    "\n",
    "        new_W = p_node.value .- current_lr .* grad_clipped\n",
    "        set!(g_pcb, :waypoints, new_W; is_param=true)\n",
    "    end\n",
    "\n",
    "    if epoch % 25 == 0 || epoch == epochs\n",
    "        IJulia.clear_output(true)\n",
    "        current_W = node(g_pcb, :waypoints).value\n",
    "\n",
    "        p = plot(title=\"Routage de Piste PCB (Époque $epoch/$epochs)\",\n",
    "                 aspect_ratio=:equal, xlims=(-2, 42), ylims=(-2, 40),\n",
    "                 legend=:outertopright, grid=true, size=(850, 650),\n",
    "                 xlabel=\"X (mm)\", ylabel=\"Y (mm)\")\n",
    "\n",
    "        couleurs = [:red, :orange, :purple]\n",
    "        for (idx, (cx, cy, hx, hy)) in enumerate(composants)\n",
    "            plot!(p, rectangle_pts(cx, cy, hx, hy)..., seriestype=:shape,\n",
    "                  fillalpha=0.35, color=couleurs[idx], label=\"Composant $idx\")\n",
    "            plot!(p, rectangle_pts(cx, cy, hx+MARGE_ISOLATION, hy+MARGE_ISOLATION)...,\n",
    "                  color=couleurs[idx], style=:dash, lw=1.2, label=\"\")\n",
    "        end\n",
    "\n",
    "        scatter!(p, [PAD_START[1]], [PAD_START[2]], color=:blue, markersize=8, label=\"Pastille départ\")\n",
    "        scatter!(p, [PAD_END[1]], [PAD_END[2]], color=:green, markersize=8, label=\"Pastille arrivée\")\n",
    "\n",
    "        X_path = vcat(PAD_START[1], current_W[:, 1], PAD_END[1])\n",
    "        Y_path = vcat(PAD_START[2], current_W[:, 2], PAD_END[2])\n",
    "        plot!(p, X_path, Y_path, color=:goldenrod, lw=3, label=\"Piste de cuivre\",\n",
    "              marker=:circle, markersize=3, markercolor=:black)\n",
    "\n",
    "        display(p)\n",
    "        sleep(0.01)\n",
    "    end\n",
    "end\n",
    "println(\"✅ Piste PCB routée : plus courte possible, sans virage inutile, hors des composants.\")\n"
   ]
  },
