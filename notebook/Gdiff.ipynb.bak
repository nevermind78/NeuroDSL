   "metadata": {},
   "outputs": [],
   "source": [
    "# =======================================================================\n",
    "# SIMULATION CLINIQUE : Interface Cerveau-Machine & Neuroplasticité\n",
    "# =======================================================================\n",
    "using LinearAlgebra\n",
    "using NeuroDSL\n",
    "\n",
    "println(\"=== DÉMARRAGE DU PROTOCOLE CLINIQUE ===\")\n",
    "\n",
    "# 1. INITIALISATION DE L'ÉTAT SAIN (Le jour de l'opération)\n",
    "# ---------------------------------------------------------\n",
    "N_canaux = 10\n",
    "N_actions = 2 # Mouvement 2D (X, Y)\n",
    "\n",
    "g_bci = NeuroGraph(device=Backend.CPUDevice())\n",
    "\n",
    "# Signal cérébral idéal et stable d'un patient qui veut bouger en (X=0.8, Y=-0.5)\n",
    "signal_sain = Float32[1.2, 0.5, -0.8, 2.1, 0.3, -1.5, 0.9, 1.1, -0.2, 0.7]\n",
    "mouvement_cible = Float32[0.8, -0.5]\n",
    "\n",
    "# Le décodeur \"usine\" de l'hôpital (Généré arbitrairement pour l'exemple, pré-entraîné)\n",
    "W_decode_hopital = randn(Float32, N_actions, N_canaux) .* 0.1f0\n",
    "\n",
    "set!(g_bci, :X_cerveau, reshape(signal_sain, N_canaux, 1); is_param=false)\n",
    "set!(g_bci, :cible, reshape(mouvement_cible, N_actions, 1); is_param=false)\n",
    "set!(g_bci, :W_decode, W_decode_hopital; is_param=false) # FIGÉ : On ne le ré-entraîne pas !\n",
    "\n",
    "# Graphe initial sain\n",
    "addrule!(g_bci, GraphRule(:mouvement, [:W_decode, :X_cerveau], :matmul))\n",
    "addrule!(g_bci, GraphRule(:loss, [:mouvement, :cible], :mse_loss))\n",
    "\n",
    "mouvement_initial = demand!(g_bci, :mouvement)\n",
    "println(\"\\n[ÉTAT SAIN] Mouvement lu par l'implant : \", vec(round.(mouvement_initial, digits=3)))\n",
    "\n",
    "\n",
    "# 2. LE DRAME BIOLOGIQUE (6 mois plus tard : Gliose et dégradation)\n",
    "# ---------------------------------------------------------\n",
    "# Électrodes 2, 4, 7 meurent (0.0). Électrodes 8 et 9 court-circuitent (bruit massif de +5.0)\n",
    "signal_corrompu = copy(signal_sain)\n",
    "signal_corrompu[[2, 4, 7]] .= 0.0f0\n",
    "signal_corrompu[[8, 9]] .+= 5.0f0\n",
    "\n",
    "# Injection de la crise dans le graphe\n",
    "set!(g_bci, :X_cerveau, reshape(signal_corrompu, N_canaux, 1); is_param=false)\n",
    "\n",
    "mouvement_crise = demand!(g_bci, :mouvement)\n",
    "loss_crise = demand!(g_bci, :loss)[1]\n",
    "println(\"\\n[CRISE BIOLOGIQUE] Électrodes mortes/bruitées !\")\n",
    "println(\"Mouvement erratique subi par le patient : \", vec(round.(mouvement_crise, digits=3)))\n",
    "println(\"Erreur (Loss) : \", round(loss_crise, digits=2), \" (Le curseur part dans le décor)\")\n",
    "\n",
    "\n",
    "# 3. INTERVENTION NEURODSL : Hot-Rewiring & Neuroplasticité\n",
    "# ---------------------------------------------------------\n",
    "println(\"\\n[THÉRAPIE] Greffe de la matrice de neuroplasticité dynamique...\")\n",
    "\n",
    "# On insère une nouvelle matrice d'identité (qui ne change rien au début)\n",
    "set!(g_bci, :W_plasticity, Matrix{Float32}(I, N_canaux, N_canaux); is_param=true)\n",
    "\n",
    "# MUTATION DU GRAPHE À CHAUD : \n",
    "# X_cerveau -> W_plasticity -> Signal_Reparé -> W_decode -> Mouvement\n",
    "addrule!(g_bci, GraphRule(:signal_repare, [:W_plasticity, :X_cerveau], :matmul))\n",
    "addrule!(g_bci, GraphRule(:mouvement, [:W_decode, :signal_repare], :matmul))\n",
    "# La loss pointe automatiquement vers le nouveau chemin grâce au re-routage de :mouvement\n",
    "\n",
    "# 4. RÉÉDUCATION EXPRESS (Apprentissage stabilisé)\n",
    "# ---------------------------------------------------------\n",
    "lr_reeduc = 1f-3\n",
    "epochs = 3000\n",
    "\n",
    "for epoch in 1:epochs\n",
    "    # Purge absolue du gradient\n",
    "    p_node = node(g_bci, :W_plasticity)\n",
    "    p_node.gradient = nothing \n",
    "    \n",
    "    zero_grads!(g_bci)\n",
    "    demand!(g_bci, :loss)\n",
    "    backward_graph!(g_bci, :loss)\n",
    "    \n",
    "    if p_node.gradient !== nothing\n",
    "        # Sécurité : Gradient clipping\n",
    "        grad_clipped = clamp.(p_node.gradient, -2.0f0, 2.0f0)\n",
    "        \n",
    "        new_W = p_node.value .- lr_reeduc .* grad_clipped\n",
    "        set!(g_bci, :W_plasticity, new_W; is_param=true)\n",
    "    end\n",
    "end\n",
    "\n",
    "mouvement_final = demand!(g_bci, :mouvement)\n",
    "loss_finale = demand!(g_bci, :loss)[1]\n",
    "\n",
    "println(\"\\n\" * \"=\"^65)\n",
    "println(\" RÉSULTAT DE LA RÉÉDUCATION DYNAMIQUE\")\n",
    "println(\"=\"^65)\n",
    "println(\"Mouvement cible attendu   : \", vec(mouvement_cible))\n",
    "println(\"Mouvement final restauré  : \", vec(round.(mouvement_final, digits=3)))\n",
    "println(\"Loss finale MSE           : \", round(loss_finale, digits=6))\n",
    "\n",
    "@assert loss_finale < 0.05 \"La neuroplasticité n'a pas convergé !\"\n",
    "println(\"\\n✅ Succès Clinique : L'IA a reconstruit l'intention du patient en croisant les canaux survivants !\")"
   ]
  },
