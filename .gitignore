# Julia
Manifest.toml
*.ipynb_checkpoints

# Fichiers volumineux (à garder en local seulement)
*.mp4
*.png

*.json   # si ce sont des logs de debug

# Temporaires
*.log
*.aux
*.out

# Environnement Julia
LocalPreferences.toml

# Dossiers de benchmarks/frames inutiles pour le dépôt public
training_frames/
adds/

# Fichiers de visualisation générés (si tu veux les garder, supprime cette ligne)

*.dot
*.svg

src/all.txt

# ── Notebooks exploratoires / brouillons / doublons (gardés en local, non
#    suivis) — seuls compiler.ipynb, graph_sim.ipynb, notebook.ipynb,
#    bell_number.ipynb, gen_simulation.ipynb, neurodsl_benchmarks.ipynb,
#    notebook_py.ipynb (source de reproductibilité citée dans l'article 1)
#    et patching.ipynb restent trackés dans notebook/.
notebook/GPT2.ipynb
notebook/GPT2_v0.ipynb
notebook/GRAPH.ipynb
notebook/Graph_dsl.ipynb
notebook/MNIST.ipynb
notebook/MNISTV2.ipynb
notebook/MNISTV3.ipynb
