notebook/ben.ipynb
notebook/paralell.ipynb
notebook/test_graph.ipynb
notebook/tests.ipynb
notebook/tmp_bench.jl

# Sorties générées par les notebooks (régénérables, pas de valeur en soi)
notebook/*.html
notebook/*.txt
notebook/data/

# Doublon quasi complet de notebook/ (mêmes exports HTML/JSON)
html/

# Scripts de patch ponctuels sur des notebooks (usage unique, pas d'API réutilisable)
scripts/

# Scratch racine
test_runtime_optim.ipynb
timing_scan.txt

# Anciennes versions de modules, gardées pour référence mais plus utilisées
old/

# Illustrations utilisées par le README — exemptées des règles *.png/*.html
# ci-dessus, qui visent les sorties de scratch, pas les assets choisis.
!assets/readme/
!assets/readme/*